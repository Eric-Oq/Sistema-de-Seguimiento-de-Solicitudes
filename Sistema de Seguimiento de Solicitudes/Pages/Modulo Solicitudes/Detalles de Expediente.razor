@page "/menu/modulo-solicitudes/indice-expedientes/detalles/{id:int}/{folio}"

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Sistema_de_Seguimiento_de_Solicitudes.Models
@using System.Collections.Generic
@using SolicitudesShared
@using MudBlazor
@using Sistema_de_Seguimiento_de_Solicitudes.Services
@using System.Text.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IExpedienteService ExpedienteService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ICalendarioService CalendarioService

<PageTitle>Detalles del Expediente</PageTitle>

<div class="page-container">

    <div class="page-header">
        <div>
            <span class="badge-status @ObtenerClaseEstatus(Expediente.Estatus)">
                @(!string.IsNullOrEmpty(Expediente.Estatus) ? Expediente.Estatus : "Sin Estatus")
            </span>
            <h1 class="title">Folio: @Expediente.Folio</h1>
            <p class="subtitle">
                <MudIcon Icon="@Icons.Material.Filled.Person" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 8px; color: #64748b;" />
                Solicitante: <strong>@Expediente.Nombre</strong>
            </p>
        </div>
        <div class="header-actions">
            <button class="btn-outline" type="button" @onclick="VolverAtras">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="width: 18px; height: 18px; flex-shrink: 0; margin-right: 6px;" /> Volver
            </button>
            @if (!EsSoloConsulta)
            {
                <button class="btn-primary" type="button" @onclick="ForzarGuardado">
                    <MudIcon Icon="@Icons.Material.Filled.Save" Style="width: 18px; height: 18px; flex-shrink: 0; margin-right: 6px;" /> Guardar Cambios
                </button>
            }
        </div>
    </div>

    @if (Expediente != null)
    {
        @if (EsSoloConsulta)
        {
            <div class="alert-readonly">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 12px;" />
                <span>Modo de solo lectura. No tienes permisos para modificar este expediente.</span>
            </div>
        }

        <div class="stage-indicator">
            <div class="stage active">
                <span class="stage-dot"></span> Etapa Inicial
            </div>
        </div>

        <EditForm Model="@Expediente" id="formExpediente">

            <div class="content-grid" disabled="@EsSoloConsulta">

                <div class="card-section">
                    <h3 class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #4f46e5;" />
                        Datos Generales
                    </h3>

                    <div class="form-grid">
                        
                        <div class="input-group span-2">
                            <label>Folio de la Solicitud</label>
                            <InputText class="modern-input" @bind-Value="Expediente.Folio" disabled="@EsSoloConsulta" placeholder="Ingrese el folio" />
                        </div>

                        <div class="input-group span-2">
                            <label>Nombre del Solicitante</label>
                            <InputText class="modern-input" @bind-Value="Expediente.Nombre" disabled="@EsSoloConsulta" placeholder="Nombre completo del solicitante" />
                        </div>

                        <div class="input-group">
                            <label>Año de Admisión</label>
                            <InputSelect class="modern-input" TValue="int" @bind-Value="Expediente.AnoAdmision" disabled="@EsSoloConsulta">
                                <option disabled value="0">-- Seleccione --</option>
                                <option value="2023">2023</option>
                                <option value="2024">2024</option>
                                <option value="2025">2025</option>
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Mes de Admisión</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.MesAdmision" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var mes in Catalogos.MesesAdmision)
                                {
                                    <option value="@mes">@mes</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Ciudad del Solicitante</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.Ciudad" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var ciudad in Catalogos.Ciudades)
                                {
                                    <option value="@ciudad">@ciudad</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Tipo de Solicitud</label>
                            <InputSelect class="modern-input" @bind-Value="_TipoSolicitudBind" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="DAI">DAI</option>
                                <option value="ARCO">ARCO</option>
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Tipo de Derecho</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.TipoDerecho" disabled="@(Expediente.TipoSolicitud != "ARCO" || EsSoloConsulta)">
                                @if (Expediente.TipoSolicitud == "ARCO")
                                {
                                    @foreach (var derechoArco in Catalogos.SolicitudARCO)
                                    {
                                        <option value="@derechoArco">@derechoArco</option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- N/A --</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Fecha de Inicio</label>
                            <InputDate class="modern-input" @bind-Value="Expediente.FechaInicioTramite" disabled="@EsSoloConsulta" />
                        </div>

                        <div class="input-group">
                            <label>Límite de Respuesta</label>
                            <InputDate class="modern-input input-readonly" @bind-Value="Expediente.FechaLimiteRespuesta" disabled />
                        </div>

                        <div class="input-group">
                            <label>¿Aplica Ampliación?</label>
                            <InputSelect class="modern-input" @bind-Value="_AmpliacionBind" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="Si">Sí</option>
                                <option value="No">No</option>
                            </InputSelect>
                        </div>

                        <div class="input-group span-2">
                            <label>Contenido de la Solicitud</label>
                            <InputTextArea class="modern-input" @bind-Value="Expediente.ContenidoSolicitud" disabled="@EsSoloConsulta" rows="4" placeholder="Detalle íntegro de lo solicitado..." />
                        </div>
                    </div>
                </div>

                <div class="card-section">
                    <h3 class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #f59e0b;" />
                        Prevención y Recepción
                    </h3>

                    <div class="form-grid">
                        <div class="input-group">
                            <label>¿Requiere Prevención?</label>
                            <InputSelect class="modern-input" @bind-Value="_PrevencionBind" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="Si">Sí</option>
                                <option value="No">No</option>
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Subsana Prevención</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.SubsanaPrevencion" disabled="@(Expediente.Prevencion != "Si" || EsSoloConsulta)">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="Si">Sí</option>
                                <option value="No">No</option>
                            </InputSelect>
                        </div>

                        <div class="input-group span-2">
                            <label>Fecha Límite para Prevención</label>
                            <InputDate class="modern-input input-readonly" @bind-Value="Expediente.FechaLimitePrevencion" disabled />
                        </div>

                        <div class="divider span-2"></div>

                        <div class="input-group span-2">
                            <label>Vía de Recepción</label>
                            <InputSelect class="modern-input" @bind-Value="_RecibidaRegistradaBind" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="PNT">PNT</option>
                                <option value="Manual">Manual</option>
                                <option value="Otro">Otro</option>
                            </InputSelect>
                        </div>

                        @if (_RecibidaRegistradaBind == "Manual")
                        {
                            <div class="input-group span-2">
                                <label>Medio de Recepción Manual</label>
                                <InputSelect class="modern-input" @bind-Value="Expediente.MedioRecepcionSolicitudManual" disabled="@EsSoloConsulta">
                                    <option disabled selected value="">-- Seleccione --</option>
                                    <option value="CORREO ELECTRÓNICO">CORREO ELECTRÓNICO</option>
                                    <option value="PRESENTACIÓN EN MÓDULO">PRESENTACIÓN EN MÓDULO</option>
                                    <option value="Otro">Otro</option>
                                </InputSelect>
                            </div>

                            @if (Expediente.MedioRecepcionSolicitudManual == "Otro")
                            {
                                <div class="input-group span-2">
                                    <label>Especifique otro medio manual</label>
                                    <InputText class="modern-input" @bind-Value="_EspecificarMedioManual" disabled="@EsSoloConsulta" placeholder="Ej. Comparecencia..." />
                                </div>
                            }
                        }
                        else if (_RecibidaRegistradaBind == "Otro")
                        {
                            <div class="input-group span-2">
                                <label>Especifique otra Vía de Recepción</label>
                                <InputText class="modern-input" @bind-Value="Expediente.MedioRecepcionSolicitudManual" disabled="@EsSoloConsulta" placeholder="Ej. Plataforma estatal..." />
                            </div>
                        }

                        <div class="input-group span-2">
                            <label>Forma de Entrega Deseada</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="ELECTRÓNICO A TRAVÉS DE PNT">ELECTRÓNICO A TRAVÉS DE PNT</option>
                                <option value="CORREO ELECTRÓNICO">CORREO ELECTRÓNICO</option>
                                <option value="MEDIO ELECTRÓNICO DEL SOLICITANTE">MEDIO ELECTRÓNICO DEL SOLICITANTE</option>
                                <option value="COPIA SIMPLE">COPIA SIMPLE</option>
                                <option value="COPIA CERTIFICADA">COPIA CERTIFICADA</option>
                                <option value="CUALQUIER OTRO MEDIO ELECTRÓNICO">CUALQUIER OTRO MEDIO ELECTRÓNICO</option>
                            </InputSelect>
                        </div>

                        @if (Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante == "CORREO ELECTRÓNICO")
                        {
                            <div class="input-group span-2">
                                <label>Ingresa el Correo Electrónico</label>
                                <InputText class="modern-input" @bind-Value="Expediente.CorreoElectronico" disabled="@EsSoloConsulta" placeholder="ejemplo@correo.com" />
                            </div>
                        }
                        else if (Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante == "CUALQUIER OTRO MEDIO ELECTRÓNICO")
                        {
                            <div class="input-group span-2">
                                <label>Especifique otro medio de entrega</label>
                                <InputText class="modern-input" @bind-Value="_EspecificarOtroMedioEntrega" disabled="@EsSoloConsulta" placeholder="Ej. WhatsApp, USB..." />
                            </div>
                        }
                    </div>
                </div>

                <div class="card-section">
                    <h3 class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #8b5cf6;" />
                        Clasificación de la Información
                    </h3>

                    <div class="form-grid">
                        <div class="input-group span-2">
                            <label>Área Poseedora de la Información</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.AreaInformacion" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione un Área --</option>
                                @foreach (var area in CatalogoAreas)
                                {
                                    <option value="@area">@area</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Materia</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.Materia" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var materia in Catalogos.Materia)
                                {
                                    <option value="@materia">@materia</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Temática</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.Tematica" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var tematica in Catalogos.Tematica)
                                {
                                    <option value="@tematica">@tematica</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group span-2">
                            <label>Temática Específica</label>
                            <InputSelect class="modern-input"
                                         @bind-Value="Expediente.TematicaEspecifica"
                                         disabled="@EsSoloConsulta">

                                <option value="">-- Seleccione --</option>

                                @if (Expediente.Tematica == "ACTIVIDADES DEL CJE")
                                {
                                    @foreach (var item in Catalogos.ActividadesCJE)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "ACTIVIDADES DEL TSJ")
                                {
                                    @foreach (var item in Catalogos.ActividadesTSJ)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "ACTIVIDADES DE LOS ÓRGANOS JURISDICCIONALES DE PRIMERA INSTANCIA")
                                {
                                    @foreach (var item in Catalogos.ActividadesOrganosJurisdiccionales)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "ADMINISTRACIÓN JUDICIAL")
                                {
                                    @foreach (var item in Catalogos.AdministracionJudicial)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "DATOS PERSONALES")
                                {
                                    @foreach (var item in Catalogos.DatosPersonales)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "DESECHADA")
                                {
                                    @foreach (var item in Catalogos.Desechada)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "IMPROCEDENCIA")
                                {
                                    @foreach (var item in Catalogos.Improcedencia)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "INCOMPETENCIA")
                                {
                                    @foreach (var item in Catalogos.Incompetencia)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "INFORMACIÓN ESTADÍSTICA")
                                {
                                    @foreach (var item in Catalogos.InformacionEstadistica)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "MANEJO PRESUPUESTAL")
                                {
                                    @foreach (var item in Catalogos.ManejoPresupuestal)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "NOTORIA INCOMPETENCIA")
                                {
                                    @foreach (var item in Catalogos.NotoriaIncompetencia)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "ORIENTACIÓN")
                                {
                                    @foreach (var item in Catalogos.Orientacion)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "PRESTACIONES LABORALES")
                                {
                                    @foreach (var item in Catalogos.PrestacionesLaborales)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "TOTAL INCOMPETENCIA")
                                {
                                    @foreach (var item in Catalogos.TotalIncompetencia)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else if (Expediente.Tematica == "USO DE RECURSOS PÚBLICOS")
                                {
                                    @foreach (var item in Catalogos.UsoRecursosPublicos)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                                else
                                {
                                    <option value="">-- Seleccione una temática --</option>
                                }

                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="card-section">
                    <h3 class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #10b981;" />
                        Resolución y Entrega
                    </h3>

                    <div class="form-grid">
                        <div class="input-group">
                            <label>Estatus Actual</label>
                            <InputSelect class="modern-input fw-bold text-primary" @bind-Value="Expediente.Estatus" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="INICIO">INICIO</option>
                                <option value="EN PROCESO">EN PROCESO</option>
                                <option value="EN PREVENCIÓN">EN PREVENCIÓN</option>
                                <option value="EN AMPLIACIÓN">EN AMPLIACIÓN</option>
                                <option value="TERMINADA">TERMINADA</option>
                                <option value="DESECHADA">DESECHADA</option>
                                <option value="CANCELADA">CANCELADA</option>
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Fecha Real de Respuesta</label>
                            <InputDate class="modern-input" @bind-Value="Expediente.FechaRespuesta" disabled="@EsSoloConsulta" />
                        </div>

                        <div class="input-group">
                            <label>Sentido de la Respuesta</label>
                             <InputSelect class="modern-input" @bind-Value="Expediente.SentidoRespuesta" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var sentido in Catalogos.SentidoRespuesta)
                                {
                                    <option value="@sentido">@sentido</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Precisión del Sentido</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.PrecisionSentidoRespuesta" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var precision in Catalogos.PrecicionSentidoRespuesta)
                                {
                                    <option value="@precision">@precision</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Modalidad de Entrega Real</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.ModalidadEntrega" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                @foreach (var modalidad in Catalogos.ModalidadEntrega)
                                {
                                    <option value="@modalidad">@modalidad</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>Cobro (Monto o N/A)</label>
                            <InputText class="modern-input" @bind-Value="Expediente.Cobro" disabled="@EsSoloConsulta" placeholder="Ej. N/A o $150.00" />
                        </div>
                        <div class="input-group">
    <label>Días de Promedio</label>
    <InputNumber class="modern-input" @bind-Value="Expediente.PromedioDiasRespuesta" disabled="@EsSoloConsulta" placeholder="Ej. 15" />
</div>

                        @if (Expediente.Ampliacion == "Si")
                        {
                            <div class="divider span-2"></div>
                            <div class="input-group">
                                <label>N° Sesión Comité (Ampliación)</label>
                                <InputNumber class="modern-input" @bind-Value="Expediente.NumeroSesionComiteAmpliacion" disabled="@EsSoloConsulta" />
                            </div>

                            <div class="input-group">
                                <label>Fecha Sesión Comité</label>
                                <InputDate class="modern-input" @bind-Value="Expediente.FechaSesionComiteAmpliacion" disabled="@EsSoloConsulta" />
                            </div>
                        }
                    </div>
                </div>

                <div class="card-section">
                    <h3 class="section-title">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #ef4444;" />
                        Medios de Impugnación y Notas
                    </h3>

                    <div class="form-grid">
                        <div class="input-group">
                            <label>¿Interpuso Recurso de Revisión?</label>
                            <InputSelect class="modern-input" @bind-Value="Expediente.RecursoRevision" disabled="@EsSoloConsulta">
                                <option disabled selected value="">-- Seleccione --</option>
                                <option value="Si">Sí</option>
                                <option value="No">No</option>
                            </InputSelect>
                        </div>

                        <div class="input-group">
                            <label>N° de Recurso</label>
                            <InputNumber class="modern-input" @bind-Value="Expediente.NumeroRecursoRevision" disabled="@(Expediente.RecursoRevision != "Si" || EsSoloConsulta)" />
                        </div>

                        <div class="input-group span-2">
                            <label>Datos del Recurso</label>
                            <InputTextArea class="modern-input" @bind-Value="Expediente.DatosRecursoRevision" disabled="@(Expediente.RecursoRevision != "Si" || EsSoloConsulta)" rows="2" placeholder="Motivo o detalle del recurso de revisión..." />
                        </div>

                        <div class="divider span-2"></div>

                        <div class="input-group span-2">
                            <label>Notas / Observaciones Internas</label>
                            <InputTextArea class="modern-input" @bind-Value="Expediente.Nota" disabled="@EsSoloConsulta" rows="3" placeholder="Comentarios adicionales para control interno..." />
                        </div>
                    </div>
                </div>

            </div>

        </EditForm>
    }
    else
    {
        <div class="loading-state">
            <p>Cargando información del expediente...</p>
        </div>
    }
</div>

@code {
    // Variable local para el campo "Otro"
    private string OtraFormaEntregaEspecifica { get; set; } = string.Empty;
    private string _EspecificarMedioManual = string.Empty;
    private string _EspecificarOtroMedioEntrega = string.Empty;

    private readonly List<string> CatalogoAreas = new List<string>
    {
        "AUTORIDAD GARANTE DEL PODER JUDICIAL",
        "CENTRO DE CONVIVENCIA FAMILIAR SUPERVISADA",
        "CENTRO ESTATAL DE JUSTICIA ALTERNATIVA",
        "COMISIÓN DE CARRERA JUDICIAL",
        "COMISIÓN DE VIGILANCIA Y DISCIPLINA",
        "COMUNICACIÓN SOCIAL Y RELACIONES PÚBLICAS",
        "CONSEJO DE ADMINISTRACIÓN",
        "CONTRALORÍA",
        "COORDINACIÓN DE PERITAJE",
        "COORDINACIÓN DE PERITOS",
        "DELEGACIÓN DE OFICIALÍA MAYOR EN ENSENADA Y SAN QUINTÍN",
        "DELEGACIÓN DE OFICIALÍA MAYOR EN TIJUANA, TECATE Y PLAYAS DE ROSARITO",
        "DEPARTAMENTO DE CONTABILIDAD Y FINANZAS",
