    [Parameter] public int Id { get; set; }
    [Parameter] public string Folio { get; set; } = string.Empty;

    private ClaimsPrincipal? Usuario;
    private bool EsSoloConsulta => Usuario?.IsInRole("CONSULTA") ?? false;

    private Expediente Expediente { get; set; } = new Expediente();
    private List<DateTime> DiasInhabiles { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Usuario = estado.User;

        DiasInhabiles = (await CalendarioService.ObtenerDiasInhabiles())
            .Select(d => d.Fecha.Date)
            .ToList();

        var listaExpedientes = await ExpedienteService.Lista();
        var expedienteDTO = listaExpedientes.FirstOrDefault(e => e.Id == Id);

        if (expedienteDTO != null)
        {
            Expediente = new Expediente
            {
                Id = expedienteDTO.Id,
                Folio = expedienteDTO.Folio ?? string.Empty,
                AnoAdmision = expedienteDTO.AnoAdmision,
                MesAdmision = expedienteDTO.MesAdmision ?? string.Empty,
                TipoSolicitud = expedienteDTO.TipoSolicitud ?? string.Empty,
                TipoDerecho = expedienteDTO.TipoDerecho ?? string.Empty,
                FechaInicioTramite = expedienteDTO.FechaInicio,
                FechaLimiteRespuesta = expedienteDTO.FechaLimiteRespuesta10dias ?? expedienteDTO.FechaLimiteRespuesta20dias,
                Ampliacion = expedienteDTO.Ampliacion ?? string.Empty,
                Estatus = expedienteDTO.Estado ?? string.Empty,
                FechaRespuesta = expedienteDTO.FechaRespuesta,
                Prevencion = expedienteDTO.Prevencion ? "Si" : "No",
                SubsanaPrevencion = expedienteDTO.SubsanaPrevencionReinicoTramite ?? string.Empty,
                FechaLimitePrevencion = expedienteDTO.FechaLimitePrevencion10dias,
                RecibidaRegistrada = expedienteDTO.RecibidaRegistrada ?? string.Empty,
                Nombre = expedienteDTO.NombreSolicitante ?? string.Empty,
                CorreoElectronico = expedienteDTO.CorreoElectronicoSolicitante ?? string.Empty,
                ContenidoSolicitud = expedienteDTO.ContenidoSolicitud ?? string.Empty,

                Ciudad = expedienteDTO.CiudadSolicitante ?? string.Empty,
                AreaInformacion = expedienteDTO.AreaPoseedoraInformacion ?? string.Empty,
                Materia = expedienteDTO.Materia ?? string.Empty,
                Tematica = expedienteDTO.Tematica ?? string.Empty,
                TematicaEspecifica = expedienteDTO.TematicaEspecifica ?? string.Empty,
                SentidoRespuesta = expedienteDTO.SentidoRespuesta ?? string.Empty,
                PrecisionSentidoRespuesta = expedienteDTO.PrecisionSentidoRespuesta ?? string.Empty,
                PromedioDiasRespuesta = expedienteDTO.PromedioDiasRespuesta,
                ModalidadEntrega = expedienteDTO.ModalidadEntrega ?? string.Empty,
                Cobro = expedienteDTO.Cobro ?? string.Empty,
                RecursoRevision = expedienteDTO.RecursoRevision ?? string.Empty,
                NumeroRecursoRevision = expedienteDTO.NumeroRecursoRevision,
                DatosRecursoRevision = expedienteDTO.DatosRecursoRevision ?? string.Empty,
                NumeroSesionComiteAmpliacion = expedienteDTO.NumeroSesionComiteAmpliacion,
                FechaSesionComiteAmpliacion = expedienteDTO.FechaSesionComiteAmpliacion,
                Nota = expedienteDTO.Nota ?? string.Empty
            };

            // 🔥 TRUCO MAGICO: Extraer "Otro" si viene concatenado de la base de datos
            string medioManualDB = expedienteDTO.MedioRecepcionSolicitudManual ?? string.Empty;
            if (medioManualDB.StartsWith("Otro: "))
            {
                Expediente.MedioRecepcionSolicitudManual = "Otro";
                _EspecificarMedioManual = medioManualDB.Substring(6);
            }
            else
            {
                Expediente.MedioRecepcionSolicitudManual = medioManualDB;
            }

            string formaEntregaDB = expedienteDTO.ComoDeseaRecibirRespuestaPersonaSolicitante ?? string.Empty;
            if (formaEntregaDB.StartsWith("Otro: "))
            {
                Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante = "CUALQUIER OTRO MEDIO ELECTRÓNICO";
                _EspecificarOtroMedioEntrega = formaEntregaDB.Substring(6);
            }
            else if (formaEntregaDB.StartsWith("Otro Forma: "))
            {
                Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante = "Otro";
                OtraFormaEntregaEspecifica = formaEntregaDB.Substring(12);
            }
            else
            {
                Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante = formaEntregaDB;
            }
        }
        else
        {
            Navigation.NavigateTo("/menu/modulo-solicitudes/indice-expedientes");
        }
    }

    private void ActualizarFechaLimite()
    {
        if (!string.IsNullOrEmpty(Expediente.TipoSolicitud))
        {
            var dias = 20;
            if (Expediente.Ampliacion == "Si") dias += 10;
            Expediente.FechaLimiteRespuesta = CalcularFechaLimite(Expediente.FechaInicioTramite, dias);
        }

        if (Expediente.Prevencion == "Si")
        {
            Expediente.FechaLimitePrevencion = CalcularFechaLimite(Expediente.FechaInicioTramite, 20);
        }
        else
        {
            Expediente.FechaLimitePrevencion = null;
            Expediente.SubsanaPrevencion = string.Empty;
        }
    }

    private DateTime CalcularFechaLimite(DateTime inicio, int dias)
    {
        var fecha = inicio.Date;
        while (dias > 0)
        {
            fecha = fecha.AddDays(1);
            if (fecha.DayOfWeek != DayOfWeek.Saturday &&
                fecha.DayOfWeek != DayOfWeek.Sunday &&
                !DiasInhabiles.Contains(fecha.Date))
            {
                dias--;
            }
        }
        return fecha;
    }

    private string _TipoSolicitudBind
    {
        get => Expediente.TipoSolicitud;
        set
        {
            Expediente.TipoSolicitud = value;
            ActualizarFechaLimite();
        }
    }

    private string _AmpliacionBind
    {
        get => Expediente.Ampliacion;
        set
        {
            Expediente.Ampliacion = value;
            ActualizarFechaLimite();
        }
    }

    private string _PrevencionBind
    {
        get => Expediente.Prevencion;
        set
        {
            Expediente.Prevencion = value;
            ActualizarFechaLimite();
        }
    }

    private string _RecibidaRegistradaBind
    {
        get => Expediente.RecibidaRegistrada;
        set => Expediente.RecibidaRegistrada = value;
    }

    private async Task ForzarGuardado()
    {
        var listaExpedientes = await ExpedienteService.Lista();
        var expedienteOriginal = listaExpedientes.FirstOrDefault(e => e.Id == Expediente.Id);

        if (expedienteOriginal == null) return;

        expedienteOriginal.Folio = Expediente.Folio;
        expedienteOriginal.AnoAdmision = Expediente.AnoAdmision;
        expedienteOriginal.MesAdmision = Expediente.MesAdmision;
        expedienteOriginal.TipoSolicitud = Expediente.TipoSolicitud;
        expedienteOriginal.TipoDerecho = Expediente.TipoDerecho;
        expedienteOriginal.FechaInicio = Expediente.FechaInicioTramite;
        expedienteOriginal.FechaLimiteRespuesta10dias = Expediente.TipoSolicitud == "DAI" ? Expediente.FechaLimiteRespuesta : null;
        expedienteOriginal.FechaLimiteRespuesta20dias = Expediente.TipoSolicitud == "ARCO" ? Expediente.FechaLimiteRespuesta : null;
        expedienteOriginal.Ampliacion = Expediente.Ampliacion;
        expedienteOriginal.Estado = Expediente.Estatus;
        expedienteOriginal.FechaRespuesta = Expediente.FechaRespuesta;
        expedienteOriginal.Prevencion = Expediente.Prevencion == "Si";
        expedienteOriginal.SubsanaPrevencionReinicoTramite = Expediente.SubsanaPrevencion;
        expedienteOriginal.FechaLimitePrevencion10dias = Expediente.FechaLimitePrevencion;
        expedienteOriginal.RecibidaRegistrada = Expediente.RecibidaRegistrada;
        expedienteOriginal.NombreSolicitante = Expediente.Nombre;
        expedienteOriginal.CorreoElectronicoSolicitante = Expediente.CorreoElectronico;
        expedienteOriginal.ContenidoSolicitud = Expediente.ContenidoSolicitud;

        // 🔥 Lógica para encapsular los campos "Otro" y guardarlos en BD
        if (Expediente.RecibidaRegistrada == "Manual" && Expediente.MedioRecepcionSolicitudManual == "Otro")
        {
            expedienteOriginal.MedioRecepcionSolicitudManual = "Otro: " + _EspecificarMedioManual;
        }
        else if (Expediente.RecibidaRegistrada == "Otro")
        {
            expedienteOriginal.MedioRecepcionSolicitudManual = Expediente.MedioRecepcionSolicitudManual;
        }
        else
        {
            expedienteOriginal.MedioRecepcionSolicitudManual = Expediente.MedioRecepcionSolicitudManual;
        }

        if (Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante == "CUALQUIER OTRO MEDIO ELECTRÓNICO")
        {
            expedienteOriginal.ComoDeseaRecibirRespuestaPersonaSolicitante = "Otro: " + _EspecificarOtroMedioEntrega;
        }
        else if (Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante == "Otro")
        {
            expedienteOriginal.ComoDeseaRecibirRespuestaPersonaSolicitante = "Otro Forma: " + OtraFormaEntregaEspecifica;
        }
        else
        {
            expedienteOriginal.ComoDeseaRecibirRespuestaPersonaSolicitante = Expediente.ComoDeseaRecibirRespuestaPersonaSolicitante;
        }

        expedienteOriginal.CiudadSolicitante = Expediente.Ciudad;
        expedienteOriginal.AreaPoseedoraInformacion = Expediente.AreaInformacion;
        expedienteOriginal.Materia = Expediente.Materia;
        expedienteOriginal.Tematica = Expediente.Tematica;
        expedienteOriginal.TematicaEspecifica = Expediente.TematicaEspecifica;
        expedienteOriginal.SentidoRespuesta = Expediente.SentidoRespuesta;
        expedienteOriginal.PrecisionSentidoRespuesta = Expediente.PrecisionSentidoRespuesta;
        expedienteOriginal.PromedioDiasRespuesta = Expediente.PromedioDiasRespuesta;
        expedienteOriginal.ModalidadEntrega = Expediente.ModalidadEntrega;
        expedienteOriginal.Cobro = Expediente.Cobro;
        expedienteOriginal.RecursoRevision = Expediente.RecursoRevision;
        expedienteOriginal.NumeroRecursoRevision = Expediente.NumeroRecursoRevision;
        expedienteOriginal.DatosRecursoRevision = Expediente.DatosRecursoRevision;
        expedienteOriginal.NumeroSesionComiteAmpliacion = Expediente.NumeroSesionComiteAmpliacion;
        expedienteOriginal.FechaSesionComiteAmpliacion = Expediente.FechaSesionComiteAmpliacion;
        expedienteOriginal.Nota = Expediente.Nota;

        var exito = await ExpedienteService.Actualizar(expedienteOriginal);
        if (exito)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Cambios guardados correctamente.");
            Navigation.NavigateTo("/menu/modulo-solicitudes/indice-expedientes");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error al guardar los cambios.");
        }
    }

    private void VolverAtras()
    {
        Navigation.NavigateTo("/menu/modulo-solicitudes/indice-expedientes");
    }

    private string ObtenerClaseEstatus(string? estatus)
    {
        if (string.IsNullOrEmpty(estatus)) return "bg-gray";
        return estatus.ToLower().Contains("terminada") ? "bg-green" : "bg-blue";
    }
}

