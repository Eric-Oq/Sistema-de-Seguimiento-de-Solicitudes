@page "/login"

@using Microsoft.AspNetCore.Components.Authorization
@using Sistema_de_Seguimiento_de_Solicitudes.Services.LoginServices
@using SolicitudesShared
@using System.Text.Json
@using MudBlazor

@layout LoginLayout

@inject AuthService AuthService
@inject CustomAuthenticationStateProvider CustomAuthStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime js

<div class="auth-layout">
    <!-- 🔥 Fondo animado (Blobs) 🔥 -->
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <div class="auth-card">
        
        <!-- ================= LADO IZQUIERDO: BRANDING ================= -->
        <div class="auth-brand">
            <!-- Círculos decorativos animados -->
            <div class="decor-circle circle-tl"></div>
            <div class="decor-circle circle-br"></div>
            
            <div class="brand-content animate-fade-in">
                <!-- Contenedor Glassmorphism para el Logo -->
                <div class="logo-glass-container">
                    <img src="https://transparencia.pjbc.gob.mx/imagenes/logos/PortalTransparencia.png" alt="Logo Transparencia" />
                </div>
                <h2 class="brand-title">Portal de Transparencia</h2>
                <p class="brand-subtitle">Sistema integral de seguimiento, gestión y transparencia institucional del Poder Judicial.</p>
            </div>
        </div>

        <!-- ================= LADO DERECHO: FORMULARIO ================= -->
        <div class="auth-form-section">
            <div class="form-header stagger-1">
                <h3>Iniciar Sesión</h3>
                <p>Ingresa tus credenciales para acceder al sistema</p>
            </div>

            <EditForm Model="sessionLogin" OnValidSubmit="LoginClicked" class="login-form">
                <DataAnnotationsValidator />

                <!-- Campo de Usuario -->
                <div class="input-wrapper stagger-2">
                    <label for="username">Nombre de Usuario</label>
                    <div class="input-box">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="input-icon" />
                        <InputText @bind-Value="sessionLogin.NombreUsuario" id="username" class="modern-field" placeholder="Ej. administrador" disabled="@IsLoading" />
                    </div>
                </div>

                <!-- Campo de Contraseña -->
                <div class="input-wrapper stagger-3">
                    <label for="password">Contraseña</label>
                    <div class="input-box">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="input-icon" />
                        <input type="password" @bind="sessionLogin.password" id="password" class="modern-field" placeholder="••••••••" disabled="@IsLoading" />
                    </div>
                </div>

                <!-- Alerta de Error -->
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-alert stagger-4">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="width: 20px; height: 20px;" />
                        <span>@errorMessage</span>
                    </div>
                }

                <!-- Botón Submit -->
                <div class="stagger-5">
                    <button type="submit" class="btn-submit" disabled="@IsLoading">
                        @if (IsLoading)
                        {
                            <span>Autenticando...</span>
                        }
                        else
                        {
                            <span>Ingresar al Sistema</span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="btn-icon" />
                        }
                    </button>
                </div>
            </EditForm>
        </div>

    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool IsLoading = false;
    private string errorMessage = string.Empty;

    private LoginDTO sessionLogin { get; set; } = new LoginDTO
    {
        NombreUsuario = string.Empty,
        password = string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await CustomAuthStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            await CustomAuthStateProvider.RemoveToken();
        }
    }

    private async Task LoginClicked()
    {
        IsLoading = true;
        errorMessage = string.Empty;

        try
        {
            LoginResponse response = await AuthService.Login(sessionLogin);

            if (!response.Flag)
            {
                await js.InvokeVoidAsync("alerta", response.Message ?? "Error desconocido al intentar iniciar sesión.");
            }
            else
            {
                NavigationManager.NavigateTo(GetSafeReturnUrl());
            }
        }
        catch (Exception)
        {
            errorMessage = "Credenciales incorrectas o problema de conexión.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl)
            || !Uri.TryCreate(new Uri(NavigationManager.BaseUri), ReturnUrl, out var destination)
            || destination.GetLeftPart(UriPartial.Authority) != new Uri(NavigationManager.BaseUri).GetLeftPart(UriPartial.Authority))
        {
            return "/menu";
        }

        return $"{destination.PathAndQuery}{destination.Fragment}";
    }
}

<style>
    /* ================= RESET Y CONTENEDOR PRINCIPAL ================= */
    .auth-layout {
        position: relative;
        min-height: 100vh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8fafc;
        background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
        background-size: 30px 30px;
        padding: 20px;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        overflow: hidden;
    }

    /* 🔥 BLOBS ANIMADOS DE FONDO 🔥 */
    .bg-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
        z-index: 0;
        animation: floatBlob 12s infinite alternate cubic-bezier(0.4, 0, 0.2, 1);
    }

    .blob-1 {
        width: 500px;
        height: 500px;
        background: #3b82f6;
        top: -10%;
        left: -10%;
    }

    .blob-2 {
        width: 400px;
        height: 400px;
        background: #8b5cf6;
        bottom: -10%;
        right: -5%;
        animation-delay: -5s;
    }

    /* ================= LA TARJETA PRINCIPAL ================= */
    .auth-card {
        position: relative;
        z-index: 10;
        display: flex;
        width: 100%;
        max-width: 1000px;
        min-height: 550px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 28px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.5) inset;
        backdrop-filter: blur(20px);
        overflow: hidden;
        /* Animación de entrada de la tarjeta */
        opacity: 0;
        transform: translateY(30px);
        animation: slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* ================= PANEL IZQUIERDO (BRANDING) ================= */
    .auth-brand {
        flex: 1;
        background: linear-gradient(145deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        padding: 4rem 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
        color: white;
    }

    .brand-content {
        position: relative;
        z-index: 10;
        max-width: 400px;
    }

    /* 🔥 LOGO GLASSMORPHISM 🔥 */
    .logo-glass-container {
        background: rgba(255, 255, 255, 0.85);
        padding: 1.5rem;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 2.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 1);
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease;
    }

    .logo-glass-container:hover {
        transform: translateY(-5px) scale(1.02);
    }

    .logo-glass-container img {
        max-width: 220px;
        display: block;
    }

    .brand-title {
        font-size: 2.4rem;
        font-weight: 800;
        margin-bottom: 1rem;
        line-height: 1.1;
        background: linear-gradient(to right, #ffffff, #94a3b8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.03em;
    }

    .brand-subtitle {
        font-size: 1.1rem;
        color: #94a3b8;
        line-height: 1.6;
        font-weight: 400;
    }

    /* Círculos decorativos latiendo */
    .decor-circle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.02);
        animation: pulseCircle 8s infinite alternate ease-in-out;
    }

    .circle-tl {
        width: 500px;
        height: 500px;
        top: -200px;
        right: -150px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .circle-br {
        width: 300px;
        height: 300px;
        bottom: -100px;
        left: -100px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
        animation-delay: -4s;
    }

    /* ================= PANEL DERECHO (FORMULARIO) ================= */
    .auth-form-section {
        flex: 1.1;
        padding: 4rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background: #ffffff;
    }

    .form-header {
        margin-bottom: 2.5rem;
    }

    .form-header h3 {
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 0.5rem;
        letter-spacing: -0.03em;
    }

    .form-header p {
        color: #64748b;
        font-size: 1.05rem;
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* ================= INPUTS PREMIUM ================= */
    .input-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .input-wrapper label {
        font-size: 0.8rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .input-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 16px;
        color: #94a3b8;
        width: 22px;
        height: 22px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .modern-field {
        width: 100%;
        height: 54px;
        background-color: #f8fafc;
        border: 2px solid transparent;
        border-radius: 14px;
        padding: 0 1rem 0 3.2rem;
        font-size: 1rem;
        font-weight: 500;
        color: #0f172a;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    /* 🔥 EFECTO GLOW EN FOCUS 🔥 */
    .modern-field:focus {
        outline: none;
        border-color: #3b82f6;
        background-color: #ffffff;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15), inset 0 2px 4px rgba(0,0,0,0.01);
    }

    .modern-field:hover:not(:focus):not(:disabled) {
        background-color: #f1f5f9;
    }

    .modern-field:focus ~ .input-icon,
    .modern-field:focus + .input-icon {
        color: #3b82f6;
        transform: scale(1.1);
    }

    .modern-field::placeholder {
        color: #cbd5e1;
        font-weight: 400;
    }

    .modern-field:disabled {
        background-color: #e2e8f0;
        cursor: not-allowed;
        opacity: 0.7;
    }

    /* ================= MENSAJE DE ERROR ================= */
    .error-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 1rem 1.2rem;
        background-color: #fef2f2;
        border-left: 4px solid #ef4444;
        border-radius: 8px;
        color: #b91c1c;
        font-size: 0.95rem;
        font-weight: 600;
        box-shadow: 0 4px 6px -1px rgba(239, 68, 68, 0.1);
    }

    /* ================= BOTÓN PREMIUM ================= */
    .btn-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        height: 56px;
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
        color: white;
        border: none;
        border-radius: 14px;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        /* Sombra del color del botón */
        box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.4);
        margin-top: 1rem;
        position: relative;
        overflow: hidden;
    }

    /* Efecto de brillo interior */
    .btn-submit::after {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        background: linear-gradient(rgba(255,255,255,0.2), transparent);
        border-radius: 14px;
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-3px);
        box-shadow: 0 15px 25px -5px rgba(37, 99, 235, 0.5);
    }

    .btn-submit:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 5px 10px -5px rgba(37, 99, 235, 0.4);
    }

    .btn-submit:disabled {
        background: #94a3b8;
        box-shadow: none;
        cursor: not-allowed;
    }

    .btn-icon {
        width: 20px;
        height: 20px;
        transition: transform 0.3s ease;
        position: relative;
        z-index: 10;
    }

    .btn-submit:hover:not(:disabled) .btn-icon {
        transform: translateX(6px);
    }

    .btn-submit span {
        position: relative;
        z-index: 10;
    }

    /* 🔥 Clases de entrada en Cascada (Stagger) 🔥 */
    .stagger-1, .stagger-2, .stagger-3, .stagger-4, .stagger-5 {
        opacity: 0;
        transform: translateY(20px);
        animation: slideUpFade 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .stagger-1 { animation-delay: 0.2s; }
    .stagger-2 { animation-delay: 0.3s; }
    .stagger-3 { animation-delay: 0.4s; }
    .stagger-4 { animation-delay: 0.5s; }
    .stagger-5 { animation-delay: 0.6s; }
    
    .animate-fade-in {
        opacity: 0;
        animation: fadeIn 1s ease forwards;
        animation-delay: 0.3s;
    }

    @@keyframes slideUpFade {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes floatBlob {
        0% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(30px, -50px) scale(1.1); }
        66% { transform: translate(-20px, 20px) scale(0.9); }
        100% { transform: translate(0, 0) scale(1); }
    }

    @@keyframes pulseCircle {
        from { transform: scale(1); opacity: 0.5; }
        to { transform: scale(1.05); opacity: 1; }
    }

    /* ================= RESPONSIVIDAD ================= */
    @@media (max-width: 960px) {
        .auth-card {
            flex-direction: column;
            min-height: auto;
            border-radius: 20px;
        }

        .auth-brand {
            padding: 3rem 2rem;
            align-items: center;
            text-align: center;
        }

        .auth-form-section {
            padding: 3rem 2rem;
        }

        .brand-title {
            font-size: 2rem;
        }
    }
</style>