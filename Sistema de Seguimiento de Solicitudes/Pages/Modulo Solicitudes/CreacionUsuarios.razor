@page "/menu/usuarios"
@page "/menu/modulo-solicitudes/CreacionUsuarios"

@attribute [Authorize]
@attribute [Authorize(Roles = "ADMINISTRADOR, SUPERVISIÓN")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Collections.Generic
@using CurrieTechnologies.Razor.SweetAlert2
@using SolicitudesShared
@using System.Text.Json
@using Sistema_de_Seguimiento_de_Solicitudes.Services
@using MudBlazor

@inject IUsuarioService UsuarioService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SweetAlertService Swal
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IExpedienteService ExpedienteService
@inject HttpClient Http

<PageTitle>Gestión de Usuarios - Seguimiento de solicitudes</PageTitle>

<div class="page-container ss-page-users motion-safe:motion-preset-fade motion-safe:motion-duration-[650ms] @((MostrarFormularioModal || MostrarModalCambioContrasena) ? "users-modal-open" : "")">
    <div class="header-flex">
        <h2 class="page-title">Gestión de Usuarios</h2>
        <button class="btn-new" @onclick="MostrarFormulario" disabled="@cargandoInicial">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Style="width: 20px; height: 20px; flex-shrink: 0;" />
            Nuevo Usuario
        </button>
    </div>

    <div class="search-bar-wrapper">
        <div class="search-container">
            <MudIcon Icon="@Icons.Material.Filled.Search" Style="width: 20px; height: 20px; flex-shrink: 0; position: absolute; left: 16px; top: 12px; color: #94a3b8;" />
            <input type="text" class="search-input" placeholder="Buscar por nombre, ID o rol..." @bind="Filtro" @bind:event="oninput" disabled="@cargandoInicial" />
        </div>
    </div>

    <div class="table-card">
        <table class="modern-table">
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Nombre de Usuario</th>
                    <th style="text-align: center;">Rol de Acceso</th>
                    <th style="text-align: center; width: 180px;">@(EsAdministrador ? "Acciones" : string.Empty)</th>
                </tr>
            </thead>
            <tbody aria-busy="@cargandoInicial">
                @if (cargandoInicial)
                {
                    <LoadingTableRows Columns="4" />
                }
                else if (!string.IsNullOrEmpty(errorCargaInicial))
                {
                    <tr>
                        <td colspan="4" role="alert" class="empty-state text-rose-700">@errorCargaInicial</td>
                    </tr>
                }
                else if (UsuariosFiltrados != null && UsuariosFiltrados.Any())
                {
                    @foreach (var usuario in PagedUsuarios)
                    {
                        <tr>
                            <td class="text-id">#@usuario.Id</td>
                            <td>
                                <div class="user-info">
                                    <div class="user-avatar">@usuario.NombreUsuario.Substring(0, 1).ToUpper()</div>
                                    <span class="text-nombre">@usuario.NombreUsuario</span>
                                </div>
                            </td>
                            <td style="text-align: center;">
                                <span class="role-badge @GetRoleClass(usuario.Rol)">@usuario.Rol</span>
                            </td>
                            <td style="text-align: center;">
                                <div class="actions-wrapper">
                                    @if (EsAdministrador)
                                    {
                                        <button class="btn-action-outline" @onclick="() => AbrirModalCambioContrasena(usuario)" title="Cambiar Contraseña">
                                            <MudIcon Icon="@Icons.Material.Filled.LockReset" Style="width: 18px; height: 18px; flex-shrink: 0;" />
                                        </button>
                                        <button class="btn-action-danger" @onclick="() => Eliminar(usuario.Id)" title="Eliminar Usuario">
                                            <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Style="width: 18px; height: 18px; flex-shrink: 0;" />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.GroupOff" Style="width: 48px; height: 48px; flex-shrink: 0; color: #cbd5e1; margin-bottom: 1rem;" />
                            <p>No se encontraron usuarios registrados.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!cargandoInicial)
        {
        <div class="pagination-container">
            <button class="btn-pag" @onclick="PrevPage" disabled="@(currentPage <= 1)">
                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Style="width: 20px; height: 20px; flex-shrink: 0;" />
            </button>
            <div class="page-numbers">
                Página <span>@currentPage</span> de @totalPages
            </div>
            <button class="btn-pag" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Style="width: 20px; height: 20px; flex-shrink: 0;" />
            </button>
        </div>
        }
    </div>
@if (MostrarFormularioModal)
{
    <div class="modern-modal-backdrop" @onclick="CerrarFormulario">
        <div class="modern-modal-box" role="dialog" aria-modal="true" aria-labelledby="nuevo-usuario-titulo" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 id="nuevo-usuario-titulo">Nuevo Usuario</h3>
                <button type="button" class="close-btn" aria-label="Cerrar formulario" @onclick="CerrarFormulario">&times;</button>
            </div>
            <EditForm Model="NuevoUsuario" OnValidSubmit="GuardarUsuario">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="user-form-field">
                        <label for="nuevo-usuario-nombre">Nombre de Usuario</label>
                        <InputText id="nuevo-usuario-nombre" class="modern-input" @bind-Value="NuevoUsuario.NombreUsuario" placeholder="Ej. juan.perez" />
                        <ValidationMessage For="@(() => NuevoUsuario.NombreUsuario)" />
                    </div>
                    <div class="user-form-field">
                        <label for="nuevo-usuario-contrasena">Contraseña</label>
                        <div class="pass-wrapper">
                            <InputText id="nuevo-usuario-contrasena" type="@(_mostrarPassword ? "text" : "password")" class="modern-input" @bind-Value="NuevoUsuario.password" placeholder="********" autocomplete="new-password" />
                            <button type="button" class="eye-btn" aria-label="@(_mostrarPassword ? "Ocultar contraseña" : "Mostrar contraseña")" @onclick="AlternarVisibilidad">
                                <MudIcon Icon="@(_mostrarPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Style="width: 20px; height: 20px; flex-shrink: 0;" />
                            </button>
                        </div>
                        <ValidationMessage For="@(() => NuevoUsuario.password)" />
                    </div>
                    <div class="user-form-field">
                        <label for="nuevo-usuario-rol">Rol asignado</label>
                        <InputSelect id="nuevo-usuario-rol" class="modern-input" @bind-Value="NuevoUsuario.Rol" required>
                            <option value="" disabled>Selecciona un rol</option>
                            @foreach (var rol in ListaRoles)
                            {
                                <option value="@rol">@rol</option>
                            }
                        </InputSelect>
                    </div>
                    @if (!string.IsNullOrEmpty(DescripcionRolSeleccionado))
                    {
                        <div class="rol-info-box">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Style="width: 16px; height: 16px; flex-shrink: 0; margin-right: 8px;" />
                            @DescripcionRolSeleccionado
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="btn-save">Crear Usuario</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (MostrarModalCambioContrasena)
{
    <div class="modern-modal-backdrop" @onclick="CerrarModalCambioContrasena">
        <div class="modern-modal-box" role="dialog" aria-modal="true" aria-labelledby="cambio-contrasena-titulo" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 id="cambio-contrasena-titulo">Nueva Contraseña</h3>
                <button type="button" class="close-btn" aria-label="Cerrar formulario" @onclick="CerrarModalCambioContrasena">&times;</button>
            </div>
            <EditForm Model="CambioContrasenaModel" OnValidSubmit="GuardarCambioContrasena">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <p class="mb-4 text-muted">Estableciendo nueva clave para <strong>@UsuarioCambioContrasena.NombreUsuario</strong></p>
                    <div class="user-form-field">
                        <label for="cambio-contrasena-nueva">Nueva contraseña</label>
                        <div class="pass-wrapper">
                            <InputText id="cambio-contrasena-nueva" type="@(_mostrarPasswordCambio ? "text" : "password")" class="modern-input" @bind-Value="CambioContrasenaModel.NuevaContrasena" placeholder="********" autocomplete="new-password" />
                            <button type="button" class="eye-btn" aria-label="@(_mostrarPasswordCambio ? "Ocultar contraseña" : "Mostrar contraseña")" @onclick="() => _mostrarPasswordCambio = !_mostrarPasswordCambio">
                                <MudIcon Icon="@(_mostrarPasswordCambio? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" Style="width: 20px; height: 20px; flex-shrink: 0;" />
                            </button>
                        </div>
                        <ValidationMessage For="@(() => CambioContrasenaModel.NuevaContrasena)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" @onclick="CerrarModalCambioContrasena">Cancelar</button>
                    <button type="submit" class="btn-save">Actualizar</button>
                </div>
            </EditForm>
        </div>
    </div>
}
</div>

@code {
    public class CambioContrasenaModelClass
    {
        [Required(ErrorMessage = "Requerido")]
        [MinLength(8, ErrorMessage = "Mínimo 8 caracteres")]
        public string NuevaContrasena { get; set; } = string.Empty;
    }

    private bool MostrarFormularioModal = false;
    private bool MostrarModalCambioContrasena = false;
    private bool EsAdministrador;
    private UsuariosDTO UsuarioCambioContrasena = null!;
    private CambioContrasenaModelClass CambioContrasenaModel = new();
    private bool _mostrarPassword = false;
    private bool _mostrarPasswordCambio = false;
    private string _filtro = string.Empty;

    private string Filtro
    {
        get => _filtro;
        set
        {
            if (_filtro != value)
            {
                _filtro = value;
                FiltrarUsuarios();
            }
        }
    }

    List<UsuariosDTO>? ListaUsuarios = null;
    private List<UsuariosDTO> UsuariosFiltrados = new();
    private bool cargandoInicial = true;
    private string errorCargaInicial = string.Empty;

    // CORRECCIÓN CS9035: Inicialización correcta de propiedades Required
    private UsuariosDTO NuevoUsuario = new UsuariosDTO
    {
        NombreUsuario = string.Empty,
        password = string.Empty,
        Rol = string.Empty
    };

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages => UsuariosFiltrados.Count == 0 ? 1 : (int)Math.Ceiling((double)UsuariosFiltrados.Count / pageSize);

    private IEnumerable<UsuariosDTO> PagedUsuarios => UsuariosFiltrados
        .OrderByDescending(e => e.Id)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            EsAdministrador = authenticationState.User.IsInRole("ADMINISTRADOR");
            ListaUsuarios = await UsuarioService.Lista_Usuarios();
            UsuariosFiltrados = new List<UsuariosDTO>(ListaUsuarios.OrderByDescending(e => e.Id));
        }
        catch (Exception ex)
        {
            errorCargaInicial = $"No fue posible cargar los usuarios: {ex.Message}";
        }
        finally
        {
            cargandoInicial = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            pageSize = await JSRuntime.InvokeAsync<int>("getPageSizeBasedOnResolution");
            StateHasChanged();
        }
    }

    private void AlternarVisibilidad() => _mostrarPassword = !_mostrarPassword;

    private void AbrirModalCambioContrasena(UsuariosDTO u)
    {
        UsuarioCambioContrasena = u;
        CambioContrasenaModel = new();
        _mostrarPasswordCambio = false;
        MostrarModalCambioContrasena = true;
    }

    private void CerrarModalCambioContrasena() => MostrarModalCambioContrasena = false;

    private async Task GuardarCambioContrasena()
    {
        if (string.IsNullOrWhiteSpace(CambioContrasenaModel.NuevaContrasena) || CambioContrasenaModel.NuevaContrasena.Length < 6)
        {
            await Swal.FireAsync("Error", "La contraseña debe tener al menos 6 caracteres.", SweetAlertIcon.Error);
            return;
        }

        var res = await UsuarioService.CambiarContrasena(UsuarioCambioContrasena.Id, CambioContrasenaModel.NuevaContrasena);
        if (res)
        {
            await Swal.FireAsync("Éxito", "Clave actualizada correctamente", SweetAlertIcon.Success);
            CerrarModalCambioContrasena();
        }
        else
        {
            await Swal.FireAsync("Error", "No se pudo actualizar la contraseña", SweetAlertIcon.Error);
        }
    }

    private void FiltrarUsuarios()
    {
        UsuariosFiltrados = ListaUsuarios!.Where(e =>
            string.IsNullOrWhiteSpace(Filtro) ||
            (e.Rol != null && e.Rol.Contains(Filtro, StringComparison.OrdinalIgnoreCase)) ||
            (e.NombreUsuario != null && e.NombreUsuario.Contains(Filtro, StringComparison.OrdinalIgnoreCase)) ||
            e.Id.ToString().Contains(Filtro)
        ).ToList();

        currentPage = 1;
        StateHasChanged();
    }

    private async Task Eliminar(int id)
    {
        var res = await Swal.FireAsync(new SweetAlertOptions
        {
            Title = "¿Estás seguro?",
            Text = "No podrás revertir esto.",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Sí, eliminar",
            CancelButtonText = "Cancelar"
        });

        if (res.IsConfirmed)
        {
            if (await UsuarioService.Eliminar(id))
            {
                await Swal.FireAsync("Eliminado", "El usuario ha sido eliminado.", SweetAlertIcon.Success);
                ListaUsuarios = await UsuarioService.Lista_Usuarios();
                FiltrarUsuarios();
            }
            else
            {
                await Swal.FireAsync("Error", "No se pudo eliminar el usuario.", SweetAlertIcon.Error);
            }
        }
    }

    private Dictionary<string, string> RolesDescripcion = new() {
        { "CONSULTA", "Tiene acceso a consultar la información registrada en cada uno de los módulos del sistema, así como a la sección de reportes." },
        { "CAPTURA", "Adicional a los derechos de CONSULTA, permite el registro y modificación de la información en los módulos." },
        { "SUPERVISIÓN", "Adicional a los derechos de CAPTURA, ejerce funciones de seguimiento (Comité de Transparencia)." },
        { "ADMINISTRADOR", "Adicional a los derechos de CAPTURA, tiene el control de catálogos, accesos y usuarios." }
    };

    private List<string> ListaRoles => RolesDescripcion.Keys
        .Where(role => EsAdministrador || role != "ADMINISTRADOR")
        .ToList();

    private string DescripcionRolSeleccionado =>
        NuevoUsuario?.Rol != null && RolesDescripcion.ContainsKey(NuevoUsuario.Rol)
        ? RolesDescripcion[NuevoUsuario.Rol] : "";

    private void MostrarFormulario() => MostrarFormularioModal = true;
    private void CerrarFormulario() => MostrarFormularioModal = false;

    private async Task GuardarUsuario()
    {
        if (ListaUsuarios!.Any(e => e.NombreUsuario == NuevoUsuario.NombreUsuario))
        {
            await Swal.FireAsync("Error", "El usuario ya existe.", SweetAlertIcon.Error);
            return;
        }

        await UsuarioService.Register(NuevoUsuario);
        ListaUsuarios = await UsuarioService.Lista_Usuarios();
        FiltrarUsuarios();
        MostrarFormularioModal = false;

        // CORRECCIÓN CS9035: Re-inicialización correcta
        NuevoUsuario = new UsuariosDTO
        {
            NombreUsuario = string.Empty,
            password = string.Empty,
            Rol = string.Empty
        };
    }

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private string GetRoleClass(string r) => r?.ToUpper() switch
    {
        "ADMINISTRADOR" => "badge-admin",
        "CONSULTA" => "badge-consulta",
        "CAPTURA" => "badge-captura",
        "SUPERVISIÓN" => "badge-super",
        _ => "badge-default"
    };
}
