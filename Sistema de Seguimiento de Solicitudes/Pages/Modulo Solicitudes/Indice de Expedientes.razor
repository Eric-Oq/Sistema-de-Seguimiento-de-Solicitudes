@page "/menu/modulo-solicitudes/indice-expedientes"

@attribute [Authorize(Roles = "CONSULTA,CAPTURA,SUPERVISIÓN,ADMINISTRADOR")]

@using Microsoft.AspNetCore.Authorization
@using System.Collections.Generic
@using SolicitudesShared
@using Sistema_de_Seguimiento_de_Solicitudes.Services
@using Sistema_de_Seguimiento_de_Solicitudes.Models
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IExpedienteService ExpedienteService
@inject ICalendarioService CalendarioService
@inject AppMessageService Messages

<PageTitle>Seguimiento de solicitudes</PageTitle>

<div class="page-container ss-page-index motion-safe:motion-preset-fade motion-safe:motion-duration-[650ms] @((MostrarFormularioModal || MostrarContenidoModal) ? "index-modal-open" : "")">

    <div class="header-flex">
        <h2 class="page-title">Consulta de Solicitudes</h2>
        @if (PuedeCapturar)
        {
            <button class="btn-new" @onclick="MostrarFormulario">
                <MudIcon Icon="@Icons.Material.Filled.Add" Style="width: 20px; height: 20px; flex-shrink: 0; margin-right: 6px;" />
                Registrar Nueva Solicitud
            </button>
        }
    </div>

    <div class="search-bar-wrapper">
        <div class="search-container">
            <MudIcon Icon="@Icons.Material.Filled.Search" Style="width: 20px; height: 20px; flex-shrink: 0; position: absolute; left: 16px; top: 12px; color: #94a3b8;" />
            <input type="text" class="search-input" placeholder="Buscar por nombre, folio, contenido, fecha, año..." @bind="Filtro" @bind:event="oninput" disabled="@cargandoInicial" />
        </div>
    </div>

    <div class="table-card">
        <div class="index-table-scroll" role="region" aria-label="Tabla de solicitudes" tabindex="0">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th style="width: 80px; text-align: center;">Acción</th>
                        <th style="width: 60px;">ID</th>
                        <th>Folio</th>
                        <th>Nombre</th>
                        <th>Fecha de Inicio</th>
                        <th style="text-align: center;">Estatus</th>
                        <th style="max-width: 350px;">Contenido de la Solicitud</th>
                    </tr>
                </thead>
                <tbody aria-busy="@cargandoInicial">
                    @if (cargandoInicial)
                    {
                        <LoadingTableRows Columns="7" />
                    }
                    else if (!string.IsNullOrEmpty(errorCargaInicial))
                    {
                        <tr>
                            <td colspan="7" role="alert" class="empty-state text-rose-700">@errorCargaInicial</td>
                        </tr>
                    }
                    else if (ExpedientesFiltrados != null && ExpedientesFiltrados.Any())
                    {
                        @foreach (var expediente in PagedExpedientes)
                        {
                            <tr>
                                <td style="text-align: center;">
                                    <DetailViewButton @key="expediente.Id" CssClass="btn-view-circle" Title="Ver detalles" OnClick="@(() => VerDetalle(expediente.Id))" />
                                </td>
                                <td class="text-id">#@expediente.Id</td>
                                <td class="text-folio">@expediente.Folio</td>
                                <td class="text-nombre">@expediente.NombreSolicitante</td>
                                <td class="text-date">@(expediente.FechaInicio.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td style="text-align: center;">
                                    <span class="status-badge @GetStatusClass(expediente.Estado ?? string.Empty)">@expediente.Estado</span>
                                </td>
                                <td>
                                    <div class="content-cell">
                                        <span class="truncate-text">@expediente.ContenidoSolicitud</span>
                                        @if (expediente.ContenidoSolicitud?.Length > 60)
                                        {
                                            <button class="btn-more" @onclick="() => OpenModal(expediente.ContenidoSolicitud)">Ver más</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="width: 48px; height: 48px; flex-shrink: 0; color: #cbd5e1; margin-bottom: 1rem;" />
                                <p>No se encontraron resultados que coincidan con tu búsqueda.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ExpedientesFiltrados != null && ExpedientesFiltrados.Any())
        {
            <div class="pagination-footer">
                <div class="pagination-info">Mostrando @PagedExpedientes.Count() de @ExpedientesFiltrados.Count registros</div>
                <div class="pagination-controls">
                    <button type="button" class="btn-pag-small" aria-label="Página anterior" title="Página anterior" @onclick="PrevPage" disabled="@(currentPage <= 1)">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Style="width: 18px; height: 18px; flex-shrink: 0;" />
                    </button>
                    <div class="page-text">Página <span>@currentPage</span> de @totalPages</div>
                    <button type="button" class="btn-pag-small" aria-label="Página siguiente" title="Página siguiente" @onclick="NextPage" disabled="@(currentPage >= totalPages)">
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Style="width: 18px; height: 18px; flex-shrink: 0;" />
                    </button>
                </div>
            </div>
        }
    </div>
<!-- ================= MODAL DE REGISTRO (GRANDE) ================= -->
@if (MostrarFormularioModal)
{
    <div class="modern-modal-backdrop" @onclick="CerrarFormulario">
        <div class="modern-modal-box large-modal" role="dialog" aria-modal="true" aria-labelledby="registro-modal-title" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 id="registro-modal-title">Registrar Nuevo Expediente</h3>
                <button type="button" class="close-btn" aria-label="Cerrar formulario" @onclick="CerrarFormulario">&times;</button>
            </div>
<EditForm Model="NuevoExpedienteVM" OnSubmit="GuardarExpediente">
                <!-- Quitamos el DataAnnotationsValidator para que no bloquee los campos ocultos -->

                <div class="scrollable-modal-body">
                    <div class="content-grid" disabled="@EsSoloConsulta">

                        <!-- TARJETA 1: DATOS GENERALES -->
                        <div class="card-section">
                            <h3 class="section-title">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #4f46e5;" />
                                Datos Generales
                            </h3>
                            <div class="form-grid">
                                <div class="input-group">
                                    <label>Folio (Obligatorio)</label>
                                    <InputText class="modern-input" @bind-Value="NuevoExpedienteVM.Folio" maxlength="20" placeholder="Ej. 12345678" />
                                </div>
                                <div class="input-group">
                                    <label>Nombre del Solicitante</label>
                                    <InputText class="modern-input" @bind-Value="NuevoExpedienteVM.Nombre" placeholder="Nombre completo" />
                                </div>

                                <div class="input-group">
                                    <label>Año de Admisión</label>
                                    <InputSelect class="modern-input" TValue="int" @bind-Value="NuevoExpedienteVM.AnoAdmision">
                                        <option disabled value="0">-- Seleccione --</option>
                                        <option value="2023">2023</option>
                                        <option value="2024">2024</option>
                                        <option value="2025">2025</option>
                                        <option value="2026">2026</option>
                                        <option value="2027">2027</option>
                                    </InputSelect>
                                </div>
                                <div class="input-group">
                                    <label>Mes de Admisión</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.MesAdmision">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var mes in Catalogos.MesesAdmision)
                                        {
                                            <option value="@mes">@mes</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Ciudad del Solicitante</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.Ciudad">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var ciudad in Catalogos.Ciudades)
                                        {
                                            <option value="@ciudad">@ciudad</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="input-group">
                                    <label>Tipo de Solicitud</label>
                                    <InputSelect class="modern-input" @bind-Value="_TipoSolicitudBind">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="DAI">DAI</option>
                                        <option value="ARCO">ARCO</option>
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Tipo de Derecho</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.TipoDerecho" disabled="@(NuevoExpedienteVM.TipoSolicitud != "ARCO")">
                                        @if (NuevoExpedienteVM.TipoSolicitud == "ARCO")
                                        {
                                            @foreach (var derechoArco in Catalogos.SolicitudARCO)
                                            {
                                                <option value="@derechoArco">@derechoArco</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">-- N/A --</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="input-group">
                                    <label>Fecha de Inicio</label>
                                    <InputDate class="modern-input" @bind-Value="NuevoExpedienteVM.FechaInicioTramite" />
                                </div>

                                <div class="input-group">
                                    <label>Límite de Respuesta</label>
                                    <InputDate class="modern-input input-readonly" @bind-Value="NuevoExpedienteVM.FechaLimiteRespuesta" disabled />
                                </div>
                                <div class="input-group">
                                    <label>¿Aplica Ampliación?</label>
                                    <InputSelect class="modern-input" @bind-Value="_AmpliacionBind">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="Si">Sí</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>

                                <div class="input-group span-2">
                                    <label>Contenido de la Solicitud</label>
                                    <InputTextArea class="modern-input" @bind-Value="NuevoExpedienteVM.ContenidoSolicitud" rows="4" placeholder="Detalle íntegro de lo solicitado..." />
                                </div>
                            </div>
                        </div>

                        <!-- TARJETA 2: PREVENCIÓN Y RECEPCIÓN -->
                        <div class="card-section">
                            <h3 class="section-title">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #f59e0b;" />
                                Prevención y Recepción
                            </h3>
                            <div class="form-grid">
                                <div class="input-group">
                                    <label>¿Requiere Prevención?</label>
                                    <InputSelect class="modern-input" @bind-Value="_PrevencionBind">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="Si">Sí</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>
                                <div class="input-group">
                                    <label>Subsana Prevención</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.SubsanaPrevencion" disabled="@(NuevoExpedienteVM.Prevencion != "Si")">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="Si">Sí</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>

                                <div class="input-group span-2">
                                    <label>Fecha Límite para Prevención</label>
                                    <InputDate class="modern-input input-readonly" @bind-Value="NuevoExpedienteVM.FechaLimitePrevencion" disabled />
                                </div>
                                <div class="divider span-2"></div>

                                <div class="input-group span-2">
                                    <label>Vía de Recepción</label>
                                    <InputSelect class="modern-input" @bind-Value="_RecibidaRegistradaBind">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="PNT">PNT</option>
                                        <option value="Manual">Manual</option>
                                        <option value="Otro">Otro</option>
                                    </InputSelect>
                                </div>

                                @if (_RecibidaRegistradaBind == "Manual")
                                {
                                    <div class="input-group span-2">
                                        <label>Medio de Recepción Manual</label>
                                        <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.MedioRecepcionSolicitudManual">
                                            <option disabled selected value="">-- Seleccione --</option>
                                            <option value="CORREO ELECTRÓNICO">CORREO ELECTRÓNICO</option>
                                            <option value="PRESENTACIÓN EN MÓDULO">PRESENTACIÓN EN MÓDULO</option>
                                            <option value="Otro">Otro</option>
                                        </InputSelect>
                                    </div>
                                    @if (NuevoExpedienteVM.MedioRecepcionSolicitudManual == "Otro")
                                    {
                                        <div class="input-group span-2">
                                            <label>Especifique otro medio manual</label>
                                            <InputText class="modern-input" @bind-Value="_EspecificarMedioManual" placeholder="Ej. Comparecencia..." />
                                        </div>
                                    }
                                }
                                else if (_RecibidaRegistradaBind == "Otro")
                                {
                                    <div class="input-group span-2">
                                        <label>Especifique otra Vía de Recepción</label>
                                        <InputText class="modern-input" @bind-Value="NuevoExpedienteVM.MedioRecepcionSolicitudManual" placeholder="Ej. Plataforma estatal..." />
                                    </div>
                                }

                                <div class="input-group span-2">
                                    <label>Forma de Entrega Deseada</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="ELECTRÓNICO A TRAVÉS DE PNT">ELECTRÓNICO A TRAVÉS DE PNT</option>
                                        <option value="CORREO ELECTRÓNICO">CORREO ELECTRÓNICO</option>
                                        <option value="MEDIO ELECTRÓNICO DEL SOLICITANTE">MEDIO ELECTRÓNICO DEL SOLICITANTE</option>
                                        <option value="COPIA SIMPLE">COPIA SIMPLE</option>
                                        <option value="COPIA CERTIFICADA">COPIA CERTIFICADA</option>
                                        <option value="CUALQUIER OTRO MEDIO ELECTRÓNICO">CUALQUIER OTRO MEDIO ELECTRÓNICO</option>
                                    </InputSelect>
                                </div>

                                @if (NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante == "CORREO ELECTRÓNICO")
                                {
                                    <div class="input-group span-2">
                                        <label>Ingresa el Correo Electrónico</label>
                                        <InputText class="modern-input" @bind-Value="NuevoExpedienteVM.CorreoElectronico" placeholder="ejemplo@correo.com" />
                                    </div>
                                }
                                else if (NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante == "CUALQUIER OTRO MEDIO ELECTRÓNICO")
                                {
                                    <div class="input-group span-2">
                                        <label>Especifique otro medio de entrega</label>
                                        <InputText class="modern-input" @bind-Value="_EspecificarOtroMedioEntrega" placeholder="Ej. WhatsApp, USB..." />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- TARJETA 3: CLASIFICACIÓN -->
                        <div class="card-section">
                            <h3 class="section-title">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #8b5cf6;" />
                                Clasificación de la Información
                            </h3>
                            <div class="form-grid">
                                <div class="input-group span-2">
                                    <label>Área Poseedora de la Información</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.AreaInformacion">
                                        <option disabled selected value="">-- Seleccione un Área --</option>
                                        @foreach (var area in CatalogoAreas)
                                        {
                                            <option value="@area">@area</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Materia</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.Materia">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var materia in Catalogos.Materia)
                                        {
                                            <option value="@materia">@materia</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Temática</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.Tematica">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var tematica in Catalogos.Tematica)
                                        {
                                            <option value="@tematica">@tematica</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group span-2">
                                    <label>Temática Específica</label>
                                    <InputSelect class="modern-input"
                                                 @bind-Value="NuevoExpedienteVM.TematicaEspecifica"
                                                 disabled="@EsSoloConsulta">

                                        <option value="">-- Seleccione --</option>

                                        @if (NuevoExpedienteVM.Tematica == "ACTIVIDADES DEL CJE")
                                        {
                                            @foreach (var item in Catalogos.ActividadesCJE)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "ACTIVIDADES DEL TSJ")
                                        {
                                            @foreach (var item in Catalogos.ActividadesTSJ)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "ACTIVIDADES DE LOS ÓRGANOS JURISDICCIONALES DE PRIMERA INSTANCIA")
                                        {
                                            @foreach (var item in Catalogos.ActividadesOrganosJurisdiccionales)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "ADMINISTRACIÓN JUDICIAL")
                                        {
                                            @foreach (var item in Catalogos.AdministracionJudicial)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "DATOS PERSONALES")
                                        {
                                            @foreach (var item in Catalogos.DatosPersonales)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "DESECHADA")
                                        {
                                            @foreach (var item in Catalogos.Desechada)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "IMPROCEDENCIA")
                                        {
                                            @foreach (var item in Catalogos.Improcedencia)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "INCOMPETENCIA")
                                        {
                                            @foreach (var item in Catalogos.Incompetencia)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "INFORMACIÓN ESTADÍSTICA")
                                        {
                                            @foreach (var item in Catalogos.InformacionEstadistica)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "MANEJO PRESUPUESTAL")
                                        {
                                            @foreach (var item in Catalogos.ManejoPresupuestal)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "NOTORIA INCOMPETENCIA")
                                        {
                                            @foreach (var item in Catalogos.NotoriaIncompetencia)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "ORIENTACIÓN")
                                        {
                                            @foreach (var item in Catalogos.Orientacion)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "PRESTACIONES LABORALES")
                                        {
                                            @foreach (var item in Catalogos.PrestacionesLaborales)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "TOTAL INCOMPETENCIA")
                                        {
                                            @foreach (var item in Catalogos.TotalIncompetencia)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else if (NuevoExpedienteVM.Tematica == "USO DE RECURSOS PÚBLICOS")
                                        {
                                            @foreach (var item in Catalogos.UsoRecursosPublicos)
                                            {
                                                <option value="@item">@item</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">-- Seleccione una temática --</option>
                                        }

                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <!-- TARJETA 4: RESOLUCIÓN -->
                        <div class="card-section">
                            <h3 class="section-title">
                                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #10b981;" />
                                Resolución y Entrega
                            </h3>
                            <div class="form-grid">
                                <div class="input-group">
                                    <label>Estatus Actual</label>
                                    <InputSelect class="modern-input fw-bold text-primary" @bind-Value="NuevoExpedienteVM.Estatus">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="INICIO">INICIO</option>
                                        <option value="EN PROCESO">EN PROCESO</option>
                                        <option value="EN PREVENCIÓN">EN PREVENCIÓN</option>
                                        <option value="EN AMPLIACIÓN">EN AMPLIACIÓN</option>
                                        <option value="TERMINADA">TERMINADA</option>
                                        <option value="DESECHADA">DESECHADA</option>
                                        <option value="CANCELADA">CANCELADA</option>
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Fecha Real de Respuesta</label>
                                    <InputDate class="modern-input" @bind-Value="NuevoExpedienteVM.FechaRespuesta" />
                                </div>

                                <div class="input-group">
                                    <label>Sentido de la Respuesta</label>
                                   <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.SentidoRespuesta">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var sentido in Catalogos.SentidoRespuesta)
                                        {
                                            <option value="@sentido">@sentido</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Precisión del Sentido</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.PrecisionSentidoRespuesta">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var precision in Catalogos.PrecicionSentidoRespuesta)
                                        {
                                            <option value="@precision">@precision</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Modalidad de Entrega Real</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.ModalidadEntrega">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        @foreach (var modalidad in Catalogos.ModalidadEntrega)
                                        {
                                            <option value="@modalidad">@modalidad</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>Cobro (Monto o N/A)</label>
                                    <InputText class="modern-input" @bind-Value="NuevoExpedienteVM.Cobro" placeholder="Ej. N/A o $150.00" />
                                </div>
                                <div class="input-group">
    <label>Días de Promedio</label>
    <InputNumber class="modern-input" @bind-Value="NuevoExpedienteVM.PromedioDiasRespuesta" placeholder="Ej. 15" />
</div>

                                @if (NuevoExpedienteVM.Ampliacion == "Si")
                                {
                                    <div class="divider span-2"></div>
                                    <div class="input-group">
                                        <label>N° Sesión Comité (Ampliación)</label>
                                        <InputNumber class="modern-input" @bind-Value="NuevoExpedienteVM.NumeroSesionComiteAmpliacion" />
                                    </div>
                                    <div class="input-group">
                                        <label>Fecha Sesión Comité</label>
                                        <InputDate class="modern-input" @bind-Value="NuevoExpedienteVM.FechaSesionComiteAmpliacion" />
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- TARJETA 5: IMPUGNACIÓN -->
                        <div class="card-section">
                            <h3 class="section-title">
                                <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 10px; color: #ef4444;" />
                                Medios de Impugnación y Notas
                            </h3>
                            <div class="form-grid">
                                <div class="input-group">
                                    <label>¿Interpuso Recurso de Revisión?</label>
                                    <InputSelect class="modern-input" @bind-Value="NuevoExpedienteVM.RecursoRevision">
                                        <option disabled selected value="">-- Seleccione --</option>
                                        <option value="Si">Sí</option>
                                        <option value="No">No</option>
                                    </InputSelect>
                                </div>

                                <div class="input-group">
                                    <label>N° de Recurso</label>
                                    <InputNumber class="modern-input" @bind-Value="NuevoExpedienteVM.NumeroRecursoRevision" disabled="@(NuevoExpedienteVM.RecursoRevision != "Si")" />
                                </div>

                                <div class="input-group span-2">
                                    <label>Datos del Recurso</label>
                                    <InputTextArea class="modern-input" @bind-Value="NuevoExpedienteVM.DatosRecursoRevision" disabled="@(NuevoExpedienteVM.RecursoRevision != "Si")" rows="2" placeholder="Motivo o detalle del recurso de revisión..." />
                                </div>
                                <div class="divider span-2"></div>

                                <div class="input-group span-2">
                                    <label>Notas / Observaciones Internas</label>
                                    <InputTextArea class="modern-input" @bind-Value="NuevoExpedienteVM.Nota" rows="3" placeholder="Comentarios adicionales para control interno..." />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancel" @onclick="CerrarFormulario">Cancelar</button>
                    <button type="submit" class="btn-save">
                        <MudIcon Icon="@Icons.Material.Filled.Save" Style="width: 18px; height: 18px; flex-shrink: 0; margin-right: 6px;" /> Registrar Expediente
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- ================= MODAL LECTURA CONTENIDO ================= -->
@if (MostrarContenidoModal)
{
    <div class="modern-modal-backdrop" @onclick="CloseModal">
        <div class="modern-modal-box content-modal" role="dialog" aria-modal="true" aria-labelledby="contenido-modal-title" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 id="contenido-modal-title">Contenido Completo de la Solicitud</h3>
                <button type="button" class="close-btn" aria-label="Cerrar contenido" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body-scroll">
                <p>@modalContenido</p>
            </div>
        </div>
    </div>
}

@if (MostrarMensajeError)
{
    <div class="modern-alert-float">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="width: 24px; height: 24px; flex-shrink: 0; margin-right: 8px;" />
        @MensajeError
    </div>
}
</div>

@code {
    // 🔥 ViewModel para el Formulario Idéntico al de Detalles 🔥
    private Expediente NuevoExpedienteVM { get; set; } = new Expediente();
    private bool EsSoloConsulta = false; // Siempre falso porque estamos creando

    // Variables de apoyo para los combos de "Otro"
    private string OtraFormaEntregaEspecifica { get; set; } = string.Empty;
    private string _EspecificarMedioManual = string.Empty;
    private string _EspecificarOtroMedioEntrega = string.Empty;

    // Catálogo de áreas
    private readonly List<string> CatalogoAreas = new List<string>
    {
        "AUTORIDAD GARANTE DEL PODER JUDICIAL",
        "CENTRO DE CONVIVENCIA FAMILIAR SUPERVISADA",
        "CENTRO ESTATAL DE JUSTICIA ALTERNATIVA",
        "COMISIÓN DE CARRERA JUDICIAL",
        "COMISIÓN DE VIGILANCIA Y DISCIPLINA",
        "COMUNICACIÓN SOCIAL Y RELACIONES PÚBLICAS",
        "CONSEJO DE ADMINISTRACIÓN",
        "CONTRALORÍA",
        "COORDINACIÓN DE PERITAJE",
        "COORDINACIÓN DE PERITOS",
        "DELEGACIÓN DE OFICIALÍA MAYOR EN ENSENADA Y SAN QUINTÍN",
        "DELEGACIÓN DE OFICIALÍA MAYOR EN TIJUANA, TECATE Y PLAYAS DE ROSARITO",
        "DEPARTAMENTO DE CONTABILIDAD Y FINANZAS",
        "DEPARTAMENTO DE INFORMÁTICA",
        "DEPARTAMENTO DE PROGRAMACIÓN Y PRESUPUESTOS",
        "DEPARTAMENTO DE RECURSOS HUMANOS",
        "DEPARTAMENTO DE SERVICIOS GENERALES",
        "DEPARTAMENTO DEL FONDO AUXILIAR",
        "DIRECCIÓN DE PLANEACIÓN, INNOVACIÓN Y ESTADÍSTICA",
        "DIRECCIÓN DE TECNOLOGÍAS DE LA INFORMACIÓN",
        "ESCUELA DE FORMACIÓN JUDICIAL",
        "INSTITUTO DE LA JUDICATURA",
        "OFICIALÍA DE PARTES COMÚN",
        "OFICIALÍA MAYOR",
        "ÓRGANO INTERNO DE CONTROL",
        "SECRETARÍA GENERAL DE ACUERDOS DEL TRIBUNAL SUPERIOR DE JUSTICIA",
        "SECRETARÍA GENERAL DEL CONSEJO DE ADMINISTRACIÓN",
        "SECRETARÍA GENERAL DEL CONSEJO DE LA JUDICATURA",
        "SERVICIO MÉDICO FORENSE",
        "SISTEMA DE JUSTICIA PENAL ORAL",
        "TRIBUNAL DE DISCIPLINA JUDICIAL",
        "TRIBUNAL LABORAL",
        "UNIDAD DE PLANEACIÓN Y DESARROLLO",
        "UNIDAD DE TRANSPARENCIA",
        "UNIDAD JURÍDICA Y ASESORÍA INTERNA"
    };

    private bool MostrarFormularioModal { get; set; } = false;
    private bool MostrarContenidoModal { get; set; }
    private string MensajeError { get; set; } = "";
    private bool MostrarMensajeError { get; set; } = false;
    private string modalContenido = "";

    private string _filtro = string.Empty;
    private string Filtro
    {
        get => _filtro;
        set
        {
            if (_filtro != value)
            {
                _filtro = value;
                _ = Buscar();
            }
        }
    }

    List<ExpedienteDTO>? listaExpedientes = null;
    private List<ExpedienteDTO> ExpedientesFiltrados { get; set; } = new();
    private bool PuedeCapturar = false;
    private bool cargandoInicial = true;
    private string errorCargaInicial = string.Empty;
    private int versionBusqueda;
    private List<DateTime> DiasInhabiles { get; set; } = new();

    private int currentPage = 1;
    private int pageSize = 12;
    private int totalPages => ExpedientesFiltrados.Count == 0 ? 1 : (int)Math.Ceiling((double)ExpedientesFiltrados.Count / pageSize);

    private IEnumerable<ExpedienteDTO> PagedExpedientes => ExpedientesFiltrados
        .OrderByDescending(e => e.Id)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            pageSize = await JSRuntime.InvokeAsync<int>("getPageSizeBasedOnResolution");
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            PuedeCapturar = user.IsInRole("CAPTURA") || user.IsInRole("SUPERVISIÓN") || user.IsInRole("ADMINISTRADOR");

            DiasInhabiles = (await CalendarioService.ObtenerDiasInhabiles())
                .Select(d => d.Fecha.Date)
                .ToList();

            listaExpedientes = await ExpedienteService.Lista();
            ExpedientesFiltrados = new List<ExpedienteDTO>(listaExpedientes.OrderByDescending(e => e.Id));
        }
        catch (Exception ex)
        {
            errorCargaInicial = $"No fue posible cargar las solicitudes: {ex.Message}";
        }
        finally
        {
            cargandoInicial = false;
        }
    }

    private async Task Buscar()
    {
        var version = ++versionBusqueda;
        var filtro = Filtro;
        if (!string.IsNullOrWhiteSpace(filtro))
        {
            var resultados = await ExpedienteService.BuscarPorTexto(filtro);
            if (version != versionBusqueda) return;
            ExpedientesFiltrados = resultados;
        }
        else
        {
            var resultados = await ExpedienteService.Lista();
            if (version != versionBusqueda) return;
            listaExpedientes = resultados;
            ExpedientesFiltrados = new List<ExpedienteDTO>(listaExpedientes.OrderByDescending(e => e.Id));
        }
        currentPage = 1;
        StateHasChanged();
    }

    private void VerDetalle(int id)
    {
        var expediente = listaExpedientes!.FirstOrDefault(e => e.Id == id);
        if (expediente != null)
        {
            Navigation.NavigateTo($"/menu/modulo-solicitudes/indice-expedientes/detalles/{id}/{expediente.Folio}");
        }
    }

    private void MostrarFormulario()
    {
        NuevoExpedienteVM = new Expediente();
        MostrarFormularioModal = true;
    }

    private void CerrarFormulario()
    {
        MostrarFormularioModal = false;
    }

    // ================= LÓGICA DE FECHAS Y BINDINGS =================
    private void ActualizarFechaLimite()
    {
        if (!string.IsNullOrEmpty(NuevoExpedienteVM.TipoSolicitud))
        {
            var dias = 20;
            if (NuevoExpedienteVM.Ampliacion == "Si") dias += 10;
            NuevoExpedienteVM.FechaLimiteRespuesta = CalcularFechaLimite(NuevoExpedienteVM.FechaInicioTramite, dias);
        }

        if (NuevoExpedienteVM.Prevencion == "Si")
        {
            NuevoExpedienteVM.FechaLimitePrevencion = CalcularFechaLimite(NuevoExpedienteVM.FechaInicioTramite, 20);
        }
        else
        {
            NuevoExpedienteVM.FechaLimitePrevencion = null;
            NuevoExpedienteVM.SubsanaPrevencion = string.Empty;
        }
    }

    private DateTime CalcularFechaLimite(DateTime inicio, int dias)
    {
        var fecha = inicio.Date;
        while (dias > 0)
        {
            fecha = fecha.AddDays(1);
            if (fecha.DayOfWeek != DayOfWeek.Saturday &&
                fecha.DayOfWeek != DayOfWeek.Sunday &&
                !DiasInhabiles.Contains(fecha.Date))
            {
                dias--;
            }
        }
        return fecha;
    }

    private string _TipoSolicitudBind
    {
        get => NuevoExpedienteVM.TipoSolicitud;
        set { NuevoExpedienteVM.TipoSolicitud = value; ActualizarFechaLimite(); }
    }

    private string _AmpliacionBind
    {
        get => NuevoExpedienteVM.Ampliacion;
        set { NuevoExpedienteVM.Ampliacion = value; ActualizarFechaLimite(); }
    }

    private string _PrevencionBind
    {
        get => NuevoExpedienteVM.Prevencion;
        set { NuevoExpedienteVM.Prevencion = value; ActualizarFechaLimite(); }
    }

    private string _RecibidaRegistradaBind
    {
        get => NuevoExpedienteVM.RecibidaRegistrada;
        set => NuevoExpedienteVM.RecibidaRegistrada = value;
    }

    // ================= GUARDAR Y MAPEAR =================
    private async Task GuardarExpediente()
    {
        if (string.IsNullOrWhiteSpace(NuevoExpedienteVM.Folio))
        {
            await MostrarAlerta("EL FOLIO ES OBLIGATORIO.");
            return;
        }

      if (listaExpedientes!.Any(e => e.Folio == NuevoExpedienteVM.Folio))
        {
            // Solo avisamos, pero al no poner 'return', el código sigue y guarda
            await Messages.WarningAsync("El número de Folio ya existe en el sistema. Se registrará como un duplicado.");
        }

        // Mapeo del ViewModel (Expediente) a DataTransferObject (ExpedienteDTO)
        var dto = new ExpedienteDTO
        {
            Folio = NuevoExpedienteVM.Folio,
            AnoAdmision = NuevoExpedienteVM.AnoAdmision,
            MesAdmision = NuevoExpedienteVM.MesAdmision,
            TipoSolicitud = NuevoExpedienteVM.TipoSolicitud,
            TipoDerecho = NuevoExpedienteVM.TipoDerecho,
            FechaInicio = NuevoExpedienteVM.FechaInicioTramite.Date.Add(DateTime.Now.TimeOfDay),
            FechaLimiteRespuesta10dias = NuevoExpedienteVM.TipoSolicitud == "DAI" ? NuevoExpedienteVM.FechaLimiteRespuesta : null,
            FechaLimiteRespuesta20dias = NuevoExpedienteVM.TipoSolicitud == "ARCO" ? NuevoExpedienteVM.FechaLimiteRespuesta : null,
            Ampliacion = NuevoExpedienteVM.Ampliacion,
            Estado = NuevoExpedienteVM.Estatus,
            FechaRespuesta = NuevoExpedienteVM.FechaRespuesta,
            Prevencion = NuevoExpedienteVM.Prevencion == "Si",
            SubsanaPrevencionReinicoTramite = NuevoExpedienteVM.SubsanaPrevencion,
            FechaLimitePrevencion10dias = NuevoExpedienteVM.FechaLimitePrevencion,
            RecibidaRegistrada = NuevoExpedienteVM.RecibidaRegistrada,
            NombreSolicitante = NuevoExpedienteVM.Nombre,
            CorreoElectronicoSolicitante = NuevoExpedienteVM.CorreoElectronico,
            ContenidoSolicitud = NuevoExpedienteVM.ContenidoSolicitud,
            CiudadSolicitante = NuevoExpedienteVM.Ciudad,
            AreaPoseedoraInformacion = NuevoExpedienteVM.AreaInformacion,
            Materia = NuevoExpedienteVM.Materia,
            Tematica = NuevoExpedienteVM.Tematica,
            TematicaEspecifica = NuevoExpedienteVM.TematicaEspecifica,
            SentidoRespuesta = NuevoExpedienteVM.SentidoRespuesta,
            PrecisionSentidoRespuesta = NuevoExpedienteVM.PrecisionSentidoRespuesta,
            ModalidadEntrega = NuevoExpedienteVM.ModalidadEntrega,
            PromedioDiasRespuesta = NuevoExpedienteVM.PromedioDiasRespuesta,
            Cobro = NuevoExpedienteVM.Cobro,
            RecursoRevision = NuevoExpedienteVM.RecursoRevision,
            NumeroRecursoRevision = NuevoExpedienteVM.NumeroRecursoRevision,
            DatosRecursoRevision = NuevoExpedienteVM.DatosRecursoRevision,
            NumeroSesionComiteAmpliacion = NuevoExpedienteVM.NumeroSesionComiteAmpliacion,
            FechaSesionComiteAmpliacion = NuevoExpedienteVM.FechaSesionComiteAmpliacion,
            Nota = NuevoExpedienteVM.Nota
        };

        // Lógica para encapsular los campos "Otro"
        if (NuevoExpedienteVM.RecibidaRegistrada == "Manual" && NuevoExpedienteVM.MedioRecepcionSolicitudManual == "Otro")
        {
            dto.MedioRecepcionSolicitudManual = "Otro: " + _EspecificarMedioManual;
        }
        else if (NuevoExpedienteVM.RecibidaRegistrada == "Otro")
        {
            dto.MedioRecepcionSolicitudManual = NuevoExpedienteVM.MedioRecepcionSolicitudManual;
        }
        else
        {
            dto.MedioRecepcionSolicitudManual = NuevoExpedienteVM.MedioRecepcionSolicitudManual;
        }

        if (NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante == "CUALQUIER OTRO MEDIO ELECTRÓNICO")
        {
            dto.ComoDeseaRecibirRespuestaPersonaSolicitante = "Otro: " + _EspecificarOtroMedioEntrega;
        }
        else if (NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante == "Otro")
        {
            dto.ComoDeseaRecibirRespuestaPersonaSolicitante = "Otro Forma: " + OtraFormaEntregaEspecifica;
        }
        else
        {
            dto.ComoDeseaRecibirRespuestaPersonaSolicitante = NuevoExpedienteVM.ComoDeseaRecibirRespuestaPersonaSolicitante;
        }

        await ExpedienteService.Crear(dto);

        listaExpedientes = await ExpedienteService.Lista();
        ExpedientesFiltrados = new List<ExpedienteDTO>(listaExpedientes.OrderByDescending(e => e.Id));

        MostrarFormularioModal = false;
        NuevoExpedienteVM = new Expediente();
    }

    private async Task MostrarAlerta(string mensaje)
    {
        MensajeError = mensaje;
        MostrarMensajeError = true;
        await Task.Delay(4000);
        MostrarMensajeError = false;
        StateHasChanged();
    }

    private void OpenModal(string contenido)
    {
        modalContenido = contenido;
        MostrarContenidoModal = true;
    }

    private void CloseModal()
    {
        MostrarContenidoModal = false;
    }

    private void PrevPage() { if (currentPage > 1) currentPage--; }
    private void NextPage() { if (currentPage < totalPages) currentPage++; }

    private string GetStatusClass(string estado)
    {
        if (string.IsNullOrEmpty(estado)) return "status-default";
        var st = estado.ToUpper();
        if (st.Contains("INICIO")) return "status-inicio";
        if (st.Contains("PROCESO")) return "status-proceso";
        if (st.Contains("TERMINAD")) return "status-terminada";
        return "status-default";
    }
}
