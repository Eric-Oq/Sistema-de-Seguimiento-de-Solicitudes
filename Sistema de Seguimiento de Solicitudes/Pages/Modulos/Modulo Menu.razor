@page "/menu"
@attribute [Authorize(Roles = "ADMINISTRADOR,SUPERVISIÓN,CAPTURA,CONSULTA")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Sistema_de_Seguimiento_de_Solicitudes.Services
@using Sistema_de_Seguimiento_de_Solicitudes.Services.LoginServices
@using SolicitudesShared

@layout MenuLayout

@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthService AuthService

<PageTitle>Seguimiento de solicitudes</PageTitle>

<div class="module-container">
    <div class="mb-6 flex flex-wrap justify-end gap-3">
        <AuthorizeView Roles="ADMINISTRADOR, SUPERVISIÓN">
            <Authorized>
                <button class="inline-flex items-center gap-2 rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white shadow-sm transition hover:bg-brand-900" @onclick="IrACrearUsuarios">
                    <i class="fas fa-user-plus" aria-hidden="true"></i>
                    Crear usuarios
                </button>
            </Authorized>
        </AuthorizeView>
        <button class="inline-flex items-center gap-2 rounded-md bg-rose-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-800" @onclick="LogoutClicked">
            <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
            Cerrar sesión
        </button>
    </div>

    <h1 class="module-header">Menú Principal</h1>
    <p class="module-subtitle">Seleccione un módulo para continuar</p>

    <div class="cards-grid">
        <!-- 1. Módulo de Solicitudes -->
        <div class="module-card card-blue" @onclick="NavigateToModuloSolicitudes">
            <i class="fas fa-file-signature card-icon"></i>
            <span class="module-title">Módulo de Solicitudes</span>
            <span class="module-description">Gestión completa de solicitudes y expedientes</span>
        </div>

        <!-- 2. Módulo de Recursos de Revisión -->
        <div class="module-card card-green" @onclick="NavigateToRecursosRevision">
            <i class="fas fa-folder-open card-icon"></i>
            <span class="module-title">Recursos de Revisión</span>
            <span class="module-description">Gestión de recursos presentados</span>
        </div>

        <!-- 3. Módulo de Denuncias -->
        <div class="module-card card-purple" @onclick="NavigateToDenuncias">
            <i class="fas fa-bullhorn card-icon"></i>
            <span class="module-title">Módulo de Denuncias</span>
            <span class="module-description">Gestión, captura y seguimiento de denuncias</span>
        </div>

        <!-- 4-12. Espacios restantes "Próximamente" -->
        @for (int i = 4; i <= 12; i++)
        {
            <div class="module-card @GetCardColor(i)" @onclick="ShowComingSoon">
                <i class="fas fa-plus-circle card-icon"></i>
                <span class="module-title">Nuevo Módulo</span>
                <span class="module-description">Próximamente...</span>
            </div>
        }
    </div>
</div>

@code {
    private async Task LogoutClicked()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private void IrACrearUsuarios()
    {
        Navigation.NavigateTo("/menu/modulo-solicitudes/CreacionUsuarios");
    }

    private string GetCardColor(int index)
    {
        string[] colors = { "card-green", "card-purple", "card-orange", "card-red", "card-teal",
                            "card-indigo", "card-pink", "card-cyan", "card-deep-orange", "card-lime", "card-brown" };
        return colors[(index - 2) % colors.Length];
    }

    private async Task ShowComingSoon()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Esta funcionalidad estará disponible próximamente");
    }

    private void NavigateToModuloSolicitudes()
    {
        Navigation.NavigateTo("/menu/modulo-solicitudes/indice-expedientes");
    }

    private void NavigateToRecursosRevision()
    {
        Navigation.NavigateTo("/menu/recursos-revision/registro/expediente");
    }

    private void NavigateToDenuncias()
    {
        Navigation.NavigateTo("/menu/denuncias"); // Ruta de tu nuevo módulo
    }
}