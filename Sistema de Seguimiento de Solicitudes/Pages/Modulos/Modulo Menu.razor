@page "/menu"
@attribute [Authorize(Roles = "ADMINISTRADOR,SUPERVISIÓN,CAPTURA,CONSULTA")]

@using Microsoft.AspNetCore.Authorization
@layout MenuLayout

<PageTitle>Seguimiento de solicitudes</PageTitle>

<div class="mx-auto max-w-[1800px] rounded-3xl bg-[#f6edf0] px-4 py-6 font-sans sm:px-8 sm:py-8 lg:px-12">
    <header class="mx-auto mb-10 mt-4 max-w-2xl text-center motion-safe:motion-preset-fade motion-safe:motion-duration-[650ms] sm:mb-12">
        <h1 class="text-3xl font-extrabold tracking-tight text-brand-950 sm:text-4xl">Menú Principal</h1>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">Seleccione un módulo para acceder a sus funciones y herramientas.</p>
    </header>

    <div class="mx-auto grid w-full max-w-[1500px] grid-cols-1 justify-items-center gap-y-8 md:grid-cols-2 md:gap-x-16">
        <div class="w-full max-w-[570px] xl:max-w-[680px] 2xl:max-w-[700px] motion-safe:motion-preset-slide-up motion-safe:motion-duration-[900ms]">
            <a href="/menu/modulo-solicitudes/indice-expedientes" aria-labelledby="solicitudes-title" class="group relative flex h-full min-h-[260px] flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white text-left shadow-[0_8px_24px_rgba(66,18,36,0.06)] hover:border-brand-300 hover:shadow-[0_18px_35px_rgba(66,18,36,0.12)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700 motion-safe:transition-all motion-safe:duration-300 motion-safe:hover:-translate-y-1">
                <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full border border-brand-100 bg-brand-50/60 motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-110"></div>
                <div aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 h-52 w-52 rounded-full border border-brand-100/80"></div>
                <div class="relative flex flex-1 flex-col items-start p-6 sm:p-8">
                    <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-800 text-white shadow-md shadow-brand-900/20 motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-110">
                        <SvgIcon Name="file" CssClass="h-6 w-6" />
                    </span>
                    <h2 id="solicitudes-title" class="mt-6 text-xl font-bold tracking-tight text-brand-950 sm:text-2xl">Módulo de Solicitudes</h2>
                    <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-600">Gestión de solicitudes y expedientes, con seguimiento de trámites y consulta de información.</p>
                </div>
                <div class="relative flex flex-wrap items-center justify-between gap-3 border-t border-brand-50 bg-brand-50/40 px-6 py-4 sm:px-8">
                    <span class="text-xs font-medium text-slate-600">Seguimiento de solicitudes</span>
                    <span class="inline-flex items-center gap-2 rounded-lg bg-brand-800 px-4 py-2.5 text-xs font-bold text-white motion-safe:transition-colors motion-safe:duration-200 motion-safe:group-hover:bg-brand-900">
                        Ingresar al módulo
                        <i class="fas fa-arrow-right motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-1" aria-hidden="true"></i>
                    </span>
                </div>
            </a>
        </div>

        <div class="w-full max-w-[570px] xl:max-w-[680px] 2xl:max-w-[700px] motion-safe:motion-preset-slide-up motion-safe:motion-duration-[900ms]">
            <a href="/menu/recursos-revision/registro/expediente" aria-labelledby="recursos-title" class="group relative flex h-full min-h-[260px] flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white text-left shadow-[0_8px_24px_rgba(66,18,36,0.06)] hover:border-brand-300 hover:shadow-[0_18px_35px_rgba(66,18,36,0.12)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-700 motion-safe:transition-all motion-safe:duration-300 motion-safe:hover:-translate-y-1">
                <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -right-20 h-72 w-72 rounded-full border border-brand-100 bg-brand-50/60 motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-110"></div>
                <div aria-hidden="true" class="pointer-events-none absolute -bottom-8 -right-8 h-52 w-52 rounded-full border border-brand-100/80"></div>
                <div class="relative flex flex-1 flex-col items-start p-6 sm:p-8">
                    <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-800 text-white shadow-md shadow-brand-900/20 motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-110">
                        <SvgIcon Name="scales" CssClass="h-6 w-6" />
                    </span>
                    <h2 id="recursos-title" class="mt-6 text-xl font-bold tracking-tight text-brand-950 sm:text-2xl">Recursos de Revisión</h2>
                    <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-600">Gestión y seguimiento de recursos de revisión y sus expedientes.</p>
                </div>
                <div class="relative flex flex-wrap items-center justify-between gap-3 border-t border-brand-50 bg-brand-50/40 px-6 py-4 sm:px-8">
                    <span class="text-xs font-medium text-slate-600">Expedientes y recursos</span>
                    <span class="inline-flex items-center gap-2 rounded-lg bg-brand-800 px-4 py-2.5 text-xs font-bold text-white motion-safe:transition-colors motion-safe:duration-200 motion-safe:group-hover:bg-brand-900">
                        Ingresar al módulo
                        <i class="fas fa-arrow-right motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:translate-x-1" aria-hidden="true"></i>
                    </span>
                </div>
            </a>
        </div>

        <div class="w-full max-w-[570px] xl:max-w-[680px] 2xl:max-w-[700px] motion-safe:motion-preset-slide-up motion-safe:motion-duration-[900ms]">
            <div aria-labelledby="denuncias-title" class="group relative flex h-full min-h-[260px] flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white text-left shadow-[0_8px_24px_rgba(66,18,36,0.06)] hover:border-brand-300 hover:shadow-[0_18px_35px_rgba(66,18,36,0.12)] motion-safe:transition-all motion-safe:duration-300 motion-safe:hover:-translate-y-1">
                <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-20 h-72 w-72 rounded-full border border-brand-100 bg-brand-50/60 motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-110"></div>
                <div aria-hidden="true" class="pointer-events-none absolute -bottom-8 -left-8 h-52 w-52 rounded-full border border-brand-100/80"></div>
                <div class="relative flex flex-1 flex-col items-start p-6 sm:p-8">
                    <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-800 text-white shadow-md shadow-brand-900/20 motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-110">
                        <i class="fas fa-shield-alt text-xl" aria-hidden="true"></i>
                    </span>
                    <h2 id="denuncias-title" class="mt-6 text-xl font-bold tracking-tight text-brand-950 sm:text-2xl">Módulo de Denuncias</h2>
                    <p class="mt-3 max-w-xl text-sm leading-relaxed text-slate-600">Gestión, captura y seguimiento de denuncias.</p>
                </div>
                <div class="relative flex flex-wrap items-center justify-between gap-3 border-t border-brand-50 bg-brand-50/40 px-6 py-4 sm:px-8">
                    <span class="text-xs font-medium text-slate-600">Seguimiento de denuncias</span>
                    <span class="rounded-full border border-brand-200 bg-brand-50 px-3 py-2 text-xs font-bold text-brand-800">Próximamente</span>
                </div>
            </div>
        </div>

        <div class="w-full max-w-[570px] xl:max-w-[680px] 2xl:max-w-[700px] motion-safe:motion-preset-fade motion-safe:motion-duration-[650ms]">
            <div class="group relative flex h-full min-h-[220px] flex-col items-center justify-center overflow-hidden rounded-2xl border-2 border-dashed border-brand-200 bg-white/50 px-6 py-8 text-center">
                <span aria-hidden="true" class="pointer-events-none absolute -left-16 -top-16 h-40 w-40 rounded-full border border-brand-100 bg-brand-50/60 motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-110"></span>
                <span aria-hidden="true" class="pointer-events-none absolute -left-8 -top-8 h-24 w-24 rounded-full border border-brand-100/80"></span>
                <span aria-hidden="true" class="relative flex h-12 w-12 items-center justify-center rounded-full bg-brand-100 text-xl text-brand-600">+</span>
                <h2 class="relative mt-4 text-base font-bold text-brand-900">Próximo módulo</h2>
                <p class="relative mt-2 max-w-[220px] text-sm leading-relaxed text-slate-500">Nuevas herramientas y servicios institucionales estarán disponibles aquí.</p>
                <span class="relative mt-5 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">Próximamente</span>
            </div>
        </div>
    </div>
</div>
