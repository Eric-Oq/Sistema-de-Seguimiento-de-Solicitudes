@using Microsoft.AspNetCore.Components

<svg class="@CssClass"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false">
    @if (Name == "search")
    {
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-4-4" />
    }
    else if (Name == "chart")
    {
        <path d="M3 3v18h18" />
        <path d="M8 16v-5" />
        <path d="M13 16V7" />
        <path d="M18 16v-8" />
    }
    else if (Name == "clipboard")
    {
        <rect x="5" y="4" width="14" height="17" rx="2" />
        <path d="M9 4.5h6a1.5 1.5 0 0 0-1.5-1.5h-3A1.5 1.5 0 0 0 9 4.5Z" />
        <path d="M9 12h6M9 16h6" />
    }
    else if (Name == "folder")
    {
        <path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
    }
    else if (Name == "folder-open")
    {
        <path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v1" />
        <path d="m3 12 1.5-1.5h15L18 19H5a2 2 0 0 1-2-2Z" />
    }
    else if (Name == "scales")
    {
        <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
        <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
        <path d="M7 21h10M12 3v18" />
        <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
    }
    else if (Name == "external-link")
    {
        <path d="M14 4h6v6M20 4l-9 9" />
        <path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
    }
    else if (Name == "file")
    {
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
        <path d="M14 2v6h6M8 13h8M8 17h8" />
    }
    else if (Name == "lock")
    {
        <rect x="4" y="10" width="16" height="11" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
    }
    else if (Name == "copy")
    {
        <rect x="8" y="8" width="12" height="13" rx="2" />
        <path d="M16 8V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h2" />
    }
    else if (Name == "close")
    {
        <path d="m18 6-12 12M6 6l12 12" />
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = "h-4 w-4";
}
