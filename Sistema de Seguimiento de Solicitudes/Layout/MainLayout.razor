@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>

<AuthorizeView>
    <Authorized>
        <RadzenComponents />

        <div class="page flex-row">
            <aside class="sidebar motion-safe:animate-sidebar-enter">
                <NavMenu />
            </aside>

            <main class="module-main">
                <article @key="Navigation.Uri.Split('?', '#')[0]" class="content module-content module-page-enter">
                    @Body
                </article>
            </main>
        </div>
    </Authorized>
    <Authorizing>
        <ModuleStartupLoading />
    </Authorizing>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>
